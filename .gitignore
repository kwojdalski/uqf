# kdb+/q
*.log
expected/
actual/
*.qlog

# OS
.DS_Store

# local machine config (data paths etc.) - see .env for the expected keys
.env

# direnv's per-directory environment, loaded on cd into the tree and unloaded
# on the way out. Ignored on its own line because the `.env` pattern above does
# NOT match `.envrc` - and an .envrc is where a source credential gets
# exported, so an unignored one is exactly the accident .env.example warns
# about. See its Secrets note.
.envrc

# local Claude Code session permissions, not project config
.claude/settings.local.json

# local q/PeachQ binaries some contributors may keep alongside the repo
/q
/peachq/

# local qStudio jar kept alongside the repo to run it
/qstudio.jar

# build output from tools this tree does not build itself - today the q-lint-rs
# wheels. The rule was removed in #383 along with scripts/dev/build.sh, whose
# output it had been added for; that was right about the script and wrong
# about the directory, which another tool was already writing into.
#
# Worth knowing what was found there when it stopped being ignored: two
# release archives build.sh had produced, one of them 538MB because
# `cp -R scripts` swept in scripts/output/ - the HDB, the tickerplant logs,
# the write-down database - and packaged 8407 runtime data files as a source
# release. A gigabyte of it, unnoticed for a month behind this line.
/dist/

# Everything the repository generates at runtime: the stack's data directory
# (output/uqs - HDB, tickerplant logs, write-down database), the test databases
# scripts/dev/dump_databento_duckdb.py builds, the ODBC build, and
# scripts/examples/timer_replay_example.q's run artifacts. Large, derived, and
# rebuilt on demand.
/output/

# Where the stack's data directory lived until it moved to output/uqs. Still
# ignored so a checkout that has not moved it yet does not show gigabytes of
# HDB as untracked; `uqs` refuses to start until it is moved.
/scripts/output/

# Python bytecode cache (python/*/'s own .gitignore covers .venv/dist/etc
# within each package; this is the general fallback)
__pycache__/
*.pyc

# editor swap files
*.swp
*.swo

# generated documentation - regenerate with scripts/dev/gen-docs.sh
build/

.venv/

# Agent worktrees: full checkouts of this repository nested inside it, created
# by the agent harness. Never committable - a `git add -A` otherwise records the
# nested checkout as a gitlink, which clones of this repo cannot resolve. Also
# excluded from ruff and ty in pyproject.toml, or every gate scans the repo twice.
.claude/worktrees/

# Local checkouts of the q linter, which is its own project and installed
# separately (see CLAUDE.md). Same category as the worktrees above: a checkout
# of another repository nested inside this one. Also excluded from ty in
# pyproject.toml - left untracked but unexcluded, its 39 type errors fail the
# ty hook and block every commit in this repository.
tools/

# Tickerplant logs written by a locally running stack. Runtime data, and
# potentially large.
tplog/

# Codex mirror of .claude/skills, generated by import-claude-assets. Each file
# is a stub carrying an ABSOLUTE path into one developer's home directory, so
# a clone would get twenty broken pointers. Machine-managed, never committed.
.agents/

# pytest-cov's data file, written by `scripts/test.py coverage`.
.coverage

/.quarto/
**/*.quarto_ipynb

# Quarto's rendered docs site. docs/_quarto.yml exists so the link gate can
# ask a real renderer to resolve every link; the output is a build artifact.
docs/_site/
