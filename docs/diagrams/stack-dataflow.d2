# stack-dataflow.d2 - which process writes which table, and which of those
# tables is real.
#
# Rendered by scripts/generate/render_diagrams.py, which CI runs with
# --check. Embedded from docs/architecture/stack.md.
#
# The companion to stack-topology.d2: that one is who connects to whom, this
# one is what flows. Kept apart because they answer different questions and
# one drawing doing both was unreadable at the width a README gives it.
#
# THE DISTINCTION THIS DIAGRAM EXISTS FOR is dashed versus solid. cross1's
# output never becomes a database table: it is a plain in-memory table in
# cross1's own process, reachable only by connecting to cross1 on :6075.
# Everything else drawn as a cylinder round-trips through the tickerplant
# into rdb1 and on to the HDB, and survives its producer restarting. Two
# jobs that look identical in src/etl/streaming/ differ exactly here, and
# the difference is one declaration: whether `publishes` names a table.

# Down, not right. Left to right is the natural reading for a pipeline and
# was the first try, but five stages of producer - table - job - table -
# storage came out 5662px wide, which a README renders as a thumbnail.
# Vertical was 3714 at twelve jobs and a reader scrolls anyway.
#
# It is 4552 at nineteen, and the growth is parallel chains rather than long
# labels - shortening every new label bought 228px of it. The alternative
# was a second diagram for the market_data -> superbook -> arbitrage half,
# which was rejected for the reason repo-overview.d2 gives for not redrawing
# the topology: two pictures of one system have to be kept in step, and the
# one nobody updates is the one being read. Splitting is the right move when
# this passes ~5000; shortening labels again is not, because that is not
# where the width is.
direction: down

vars: {
  d2-config: {
    pad: 40
  }
}

classes: {
  producer: {
    style: {
      fill: "#f6f0e6"
      stroke: "#a8762f"
      font-color: "#5c3f13"
      border-radius: 6
    }
  }
  job: {
    style: {
      fill: "#eaf5ef"
      stroke: "#3d7a5a"
      font-color: "#1d4733"
      border-radius: 6
    }
  }
  table: {
    shape: cylinder
    style: {
      fill: "#eef3fb"
      stroke: "#4a6fa5"
      font-color: "#1e3a5f"
    }
  }
  private: {
    shape: cylinder
    style: {
      fill: "#fbfcfd"
      stroke: "#8a7f6a"
      font-color: "#3d3527"
      stroke-dash: 4
    }
  }
  store: {
    style: {
      fill: "#eef1f4"
      stroke: "#5a6a78"
      font-color: "#25323d"
      border-radius: 6
    }
  }
}

# --------------------------------------------------------------- producers

feed1: "feed1\nvendored" { class: producer }
fxfeed1: "fxfeed1" { class: producer }
fxorderbookfeed1: "fxorderbookfeed1" { class: producer }
widefeed1: "widefeed1" { class: producer }
fxtradesfeed1: "fxtradesfeed1" { class: producer }
cryptomock1: "cryptomock1\nstands in for cryptorust's\ntwo recorders" { class: producer }
fxordersfeed1: "fxordersfeed1\nsynthetic order flow" { class: producer }
databento_py: "databento_feed.py\nexternal Python handler" { class: producer }
kafka_py: "kafka_feed.py\nexternal Python consumer\n(alternative to kafka_feed1)" { class: producer }
kafka_feed1: "kafka_feed1\nnative q consumer (KX kfk)\non demand" { class: producer }
flink_py: "flink_vwap_streamer.py\nexternal Apache Flink job" { class: producer }

# ------------------------------------------------------------- the tables

quote: "quote\nvendored schema" { class: table }
trade: "trade\nvendored schema" { class: table }
fx_orderbook: "fx_orderbook\ntime · sym · bid/ask_prices · bid/ask_sizes" { class: table }
wide_orderbook: "wide_orderbook\ntime · sym · bids0..10 · asks0..10" { class: table }
trades: "trades\ntime · sym · side · trade_price\nsize · pip_factor · fill_id" { class: table }
executions: "executions\nsource_time · sym · venue · side · size · price\nfee · fee_ccy · fill_id · book · product" { class: table }
crypto_book: "crypto_book\ntime · source_time · venue · sym · bid/ask_prices · bid/ask_sizes" { class: table }
crypto_trades: "crypto_trades\ntime · sym · venue · side · trade_price · size\nfee · fee_currency · exchange_fill_id" { class: table }

mkt_orderbook: "mkt_orderbook\ntime · sym · bid/ask_prices" { class: table }
position: "position\nqty · avg_price · realized_pnl\nmark_price · unrealized_pnl · total_pnl" { class: table }
demo_execution_quality: "demo_execution_quality\ntrade_time · horizon · trade_price\nref_price · markout_pips · fill_id" { class: table }
cross_quotes: "cross_quotes\nnever written to stp1 —\nlives in cross1's memory" { class: private }

databento_mbp10: "databento_mbp10\nDatabento's own columns,\nten levels each side" { class: table }
eq_orderbook: "eq_orderbook\ntime · sym · bid/ask prices+sizes" { class: table }
orders: "orders\ntime · order_id · sym · book · product\nside · size · price · order_status" { class: table }
fx_position: "fx_position\nthe whole book each snapshot" { class: table }
fx_limit_breach: "fx_limit_breach\none row per NEW breach" { class: table }
market_data: "market_data\none book shape from\nevery venue's book" { class: table }
superbook: "superbook\nliquidity merged across sources" { class: table }
arbitrage: "arbitrage\nbid over ask in the merged book" { class: table }
last_value: "last_value\nthe current price of every sym:\nread the last row per sym" { class: table }
cross_arbitrage: "cross_arbitrage\ndirect vs a synthetic route" { class: table }
config_change: "config_change\nwho changed which knob" { class: table }
kafka_message: "kafka_message\neach record, undecoded,\ntopic · partition · offset" { class: table }
kafka_dead_letter: "kafka_dead_letter\nrecords that could not be decoded" { class: table }
client_flow: "client_flow\nclient FX flow, each record once" { class: table }
crypto_book_snapshot: "crypto_book_snapshot\nsampled cryptorust books, five\nlevels a side, each record once" { class: table }
flink_vwap_raw: "flink_vwap_raw\nwindows as Flink emits them" { class: table }
flink_vwap: "flink_vwap\nVWAP per sym per window, once" { class: table }
crypto_book_1s: "crypto_book_1s\nvenue · sym · bar_start · source_time\nthe last book state per second" { class: table }
book_liquidity_1m: "book_liquidity_1m\nsym · source · req_size · bar_start\nmean sweep price, quantity, full ratio" { class: table }
exec_bar: "exec_bar\nsym · bar_start · open · high · low\nclose · volume · vwap · trades" { class: table }
order_outcomes: "order_outcomes\nsource · request_id · outcome\nbook · product · venue" { class: table }
order_quality: "order_quality\nbook · window · as_of · n_orders\nfill_ratio · reject_ratio" { class: table }
fx_markout: "fx_markout\nexecution · horizon · kind · step\nmarkout, residual, leg allocations" { class: table }
fx_markout_wide: "fx_markout_wide\nexecution · horizon\nthe same, a row each, legs side by side" { class: table }
crypto_execution_quality: "crypto_execution_quality\ntrade_time · horizon · venue\ntrade_price · ref_price · markout_bps" { class: table }

# --------------------------------------------------------------- the jobs

cross1: "cross1\n.qf.mkt.cross_book_at" { class: job }
vectorize1: "vectorize1\n.qf.mkt.book_from_wide_levels" { class: job }
posbook1: "posbook1\n.qf.port.apply_fill + .qf.port.pnl" { class: job }
executions1: "executions1\nnormalizer: every fill\ntable as one" { class: job }
demo_markout1: "demo_markout1\n.qf.exec.markout_at_horizons\nscores on a 1s timer, not on arrival" { class: job }
fxpositions1: "fxpositions1\n.qf.port desk book + limits\nnets executions, on a timer" { class: job }
marketdata1: "marketdata1\nnormalizer" { class: job }
superbook1: "superbook1\n.qpipe.job.superbook merge\nacross sources" { class: job }
databento1: "databento1\nthe same .qetl.transform fold\nthe backfill declares" { class: job }
arbitrage1: "arbitrage1\ncrossed levels in the merged book" { class: job }
last_value1: "last_value1\nnewest top of book per sym\nolder books are dropped" { class: job }
crossarb1: "crossarb1\n.qf.mkt.cross_book_chain_at_sizes" { class: job }
kafka_flow1: "kafka_flow1\ndeduplicates on (partition;offset)\nstarted with its consumer" { class: job }
crypto_book_decoder1: "crypto_book_decoder1\ncryptorust books, wide, each\nrecord once; with its consumer" { class: job }
flink_vwap1: "flink_vwap1\ndeduplicates on (sym;window_end)\nstarted with its Flink job" { class: job }
crypto_markout1: "crypto_markout1\nmarkouts in bps against the\nbest mid across venues" { class: job }
exec_bars1: "exec_bars1\nopen/high/low/close/vwap per\nminute; late fills amend it" { class: job }
order_outcomes1: "order_outcomes1\nnormalizer: every order source\nas one outcome contract" { class: job }
order_quality1: "order_quality1\nrolling fill and reject rate per\nbook over 1m, 5m and 1h" { class: job }
crypto_book_1s1: "crypto_book_1s1\nlast book state per venue, sym\nand second; no forward fill" { class: job }
book_liquidity_1m1: "book_liquidity_1m1\nwhat each FX provider's book can fill,\naveraged over a minute's snapshots" { class: job }
fxmarkout1: "fxmarkout1\nnormalized FX markouts: one calculation,\nlong layout; scored once covered" { class: job }
fxmarkoutwide1: "fxmarkoutwide1\nthe same calculation, wide layout" { class: job }

storage: "rdb1 — today's ticks\n↓ EOD writedown\nhdb1 / hdb2 — on disk" { class: store }

# ------------------------------------------------------------------ writes

feed1 -> quote
feed1 -> trade
fxfeed1 -> quote
fxorderbookfeed1 -> fx_orderbook
widefeed1 -> wide_orderbook
fxtradesfeed1 -> trades
cryptomock1 -> crypto_book
cryptomock1 -> crypto_trades: "one message per fill,\nthe recorder's wire shape"
fxordersfeed1 -> orders
databento_py -> databento_mbp10

# ------------------------------------------------- subscribe, then publish

fx_orderbook -> cross1: "subscribe"
cross1 -> cross_quotes: "in-process only" { style.stroke-dash: 4 }

wide_orderbook -> vectorize1: "subscribe"
vectorize1 -> mkt_orderbook: "republish"

trades -> executions1: "one shape in"
crypto_trades -> executions1: "another"
orders -> executions1: "the filled ones"
executions1 -> executions: "one shape out"

databento_mbp10 -> databento1: "subscribe"
databento1 -> eq_orderbook: "republish"

executions -> posbook1: "subscribe"
market_data -> posbook1: "mark each fill at the mid\nas of its own time"
posbook1 -> position: "republish"

trades -> demo_markout1: "subscribe, buffered"
quote -> demo_markout1: "buffered"
demo_markout1 -> demo_execution_quality: "republish"

executions -> fxpositions1: "subscribe"
fxpositions1 -> fx_position: "republish"
fxpositions1 -> fx_limit_breach: "new breaches only"
fxpositions1 -> config_change: "a limit change" { style.stroke-dash: 4 }

quote -> marketdata1: "one shape in"
fx_orderbook -> marketdata1: "another"
crypto_book -> marketdata1: "and crypto"
marketdata1 -> market_data: "one shape out"

market_data -> superbook1: "subscribe, FX only"
superbook1 -> superbook: "republish"
superbook1 -> config_change { style.stroke-dash: 4 }

market_data -> last_value1: "subscribe, FX and crypto"
last_value1 -> last_value: "republish what changed"

superbook -> arbitrage1: "subscribe"
arbitrage1 -> arbitrage: "republish"

superbook -> crossarb1: "subscribe"
crossarb1 -> cross_arbitrage: "republish"
crossarb1 -> config_change: "a knob change, either side" { style.stroke-dash: 4 }

kafka_py -> kafka_message
kafka_feed1 -> kafka_message
kafka_message -> kafka_flow1: "subscribe"
kafka_flow1 -> client_flow: "decode, each once"
kafka_flow1 -> kafka_dead_letter: "what it cannot decode"
kafka_message -> crypto_book_decoder1: "subscribe"
crypto_book_decoder1 -> crypto_book_snapshot: "decode, each once"
crypto_book_decoder1 -> kafka_dead_letter: "what it cannot decode"
flink_py -> flink_vwap_raw
flink_vwap_raw -> flink_vwap1: "subscribe"
flink_vwap1 -> flink_vwap: "republish, each once"

crypto_trades -> crypto_markout1: "subscribe"
crypto_book -> crypto_markout1: "best mid"
crypto_markout1 -> crypto_execution_quality: "republish"

executions -> exec_bars1: "subscribe"
exec_bars1 -> exec_bar: "republish, each bar once"

orders -> order_outcomes1: "adapted"
order_outcomes1 -> order_outcomes: "one contract out"
order_outcomes -> order_quality1: "subscribe"
order_quality1 -> order_quality: "republish, every 5 s"
crypto_book -> crypto_book_1s1: "subscribe"
crypto_book_1s1 -> crypto_book_1s: "republish, each snapshot once"

market_data -> book_liquidity_1m1: "subscribe"
book_liquidity_1m1 -> book_liquidity_1m: "republish, each minute once"
executions -> fxmarkout1: "subscribe"
market_data -> fxmarkout1: "books"
fxmarkout1 -> fx_markout: "republish"
executions -> fxmarkoutwide1: "subscribe"
market_data -> fxmarkoutwide1: "books"
fxmarkoutwide1 -> fx_markout_wide: "republish"

# --------------------------------------------------------------- persisted

quote -> storage
trade -> storage
fx_orderbook -> storage
wide_orderbook -> storage
trades -> storage
crypto_book -> storage
crypto_trades -> storage
executions -> storage
exec_bar -> storage
order_quality -> storage
crypto_book_1s -> storage
book_liquidity_1m -> storage
mkt_orderbook -> storage
position -> storage
demo_execution_quality -> storage
databento_mbp10 -> storage
eq_orderbook -> storage
orders -> storage
fx_position -> storage
fx_limit_breach -> storage
market_data -> storage
superbook -> storage
arbitrage -> storage
last_value -> storage
cross_arbitrage -> storage
config_change -> storage
kafka_message -> storage
kafka_dead_letter -> storage
flink_vwap_raw -> storage
flink_vwap -> storage
client_flow -> storage
crypto_book_snapshot -> storage
crypto_execution_quality -> storage
fx_markout -> storage
fx_markout_wide -> storage
