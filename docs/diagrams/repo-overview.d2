# repo-overview.d2 - the whole of uqf on one page.
#
# Rendered to repo-overview.svg by scripts/generate/render_diagrams.py, which CI runs
# with --check: editing this file without re-rendering fails the build, the
# same gate docs/man.q and the contract surface already have.
#
# WHAT THIS DIAGRAM IS FOR, and what it leaves out.
#
# It answers "what is in this repository, and what depends on what". It is
# NOT the running stack: who connects to whom over IPC, with ports, is
# docs/architecture/stack.md's process topology, and drawing it twice
# would give two pictures to keep in step. It is not a namespace index
# either - docs/man.q is generated for that. Every box is a directory or a
# published interface, so a reader can go and open it.
#
# The property worth drawing over all others is the TorQ boundary. Every q
# file under src/ loads in a plain q process with no TorQ present, which is
# what lets a worker or a streaming job be tested against a recorder instead
# of a tickerplant. Only scripts/processes may know TorQ exists - its runners
# build on .qtorq (torq_pipeline.q) - and scripts/gates/check_etl_layering.py
# fails the build if anything under src/etl/ reaches for it. So the runners
# get their own band, and the pipeline's only arrow into the stack leaves
# from there. run_stream.q sits beside them because it is a runner too, but
# it runs a streaming job on stock kdb+ against .qetl.tick and never loads
# lib/torq.
#
# THE LIVE FEEDS DO NOT GO THROUGH src/. The cryptorust recorders, the
# Databento handler and the Kafka consumer are external publishers that uqs
# starts: each opens its own IPC handle to the tickerplant and calls .u.upd
# (python/uqs/src/uqs/external/). A streaming job then subscribes to what
# they publish. The batch sources are the other way round: a bounded worker
# reads them, one window at a time, through a source contract declared under
# src/etl/sources/. An earlier version of this diagram drew every feed into
# the declarations, which was true of neither.
#
# LAYOUT. ELK, top to bottom, so every edge is drawn at right angles and
# routed round the boxes rather than across them. The version before was a
# fixed two-column grid; a grid draws its cross-column edges as straight
# lines, and five of them cut diagonally across the page and through the
# band titles. Two consequences of ELK shape the source below:
#
# - Each band's title sits on the side its edges do not use: scripts' at
#   bottom-right, because both edges enter it from the top and its one edge
#   leaves from the left of its bottom; the stack's at bottom-left, because
#   every edge enters it from above. Move an edge and check its band's title.
# - ELK lays a container's children out in the global direction, so a band
#   whose boxes are joined by an edge stacks them vertically. The stack's
#   three processes and the runners therefore carry their flow in their
#   labels ("fed by stp1") rather than as edges, which keeps each band one row.
#
# ON SIZE. A holistic diagram earns its place by being READ, so it is kept to
# boxes a reader takes in at once: a directory each, a line or two of what it
# is. Detail belongs on the page that needs it.
#
# ON COLOUR. Light fills with dark text in BOTH themes, rather than a d2
# --dark-theme pairing: d2 still applies explicit styles in dark mode
# (d2lang/d2#831), so a theme pair leaves half the diagram unreadable. A
# light card on GitHub's dark background reads fine; a dark fill behind a
# dark label does not. An edge takes the colour of the box that owns the
# relationship: brown from outside, green from the framework, red from the
# TorQ runners, purple from Python.

direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  ext: {
    style: {
      fill: "#f4f1ea"
      stroke: "#8a7f6a"
      font-color: "#3d3527"
      border-radius: 14
    }
  }
  py: {
    style: {
      fill: "#f3eefb"
      stroke: "#6f4aa5"
      font-color: "#3a1e5f"
      border-radius: 6
    }
  }
  lib: {
    style: {
      fill: "#eef3fb"
      stroke: "#4a6fa5"
      font-color: "#1e3a5f"
      border-radius: 6
    }
  }
  fw: {
    style: {
      fill: "#eaf5ef"
      stroke: "#3d7a5a"
      font-color: "#1d4733"
      border-radius: 6
    }
  }
  decl: {
    style: {
      fill: "#f6f0e6"
      stroke: "#a8762f"
      font-color: "#5c3f13"
      border-radius: 6
    }
  }
  adapter: {
    style: {
      fill: "#fbeef0"
      stroke: "#a54a5c"
      font-color: "#5f1f2c"
      border-radius: 6
    }
  }
  runtime: {
    style: {
      fill: "#eef1f4"
      stroke: "#5a6a78"
      font-color: "#25323d"
      border-radius: 6
    }
  }
  band: {
    label.near: top-left
    style: {
      fill: "#fbfcfd"
      stroke: "#c3c9cf"
      font-color: "#25323d"
      stroke-width: 2
      border-radius: 10
      font-size: 18
    }
  }
}

# ================================================================== bands
#
# DECLARATION ORDER IS LAYOUT. ELK breaks ties by the order bands, boxes and
# edges appear here, and reordering them - even to read more naturally - has
# put "triggers a window" across "status files" and an edge through src/'s
# title. Re-render and look before committing any reorder.

outside: "Outside the repository" {
  class: band

  live: "Live feeds\nBinance · Bybit (cryptorust)\nDatabento MBP-10 · Kafka" { class: ext }
  batch: "Batch sources\nDuckDB · an upstream kdb+ · HDBs" { class: ext }
  airflow: "Airflow\nschedules the backfills" { class: ext }
  browser: "Browser" { class: ext }
}

src: "src/ — plain q, never loads TorQ" {
  class: band

  decls: "Declarations\nsources · workers · streaming\nreactions · transforms" { class: decl }
  quant: "Quant library\nfoundation · pricing · portfolio\nexecution · market_data" { class: lib }
  core: "src/etl/core — the framework\nbounded · streaming · normalizer\ncoverage · runs · .qetl.tick" { class: fw }

  decls -> core { style.stroke: "#5a6a78" }
  quant -> core { style.stroke: "#5a6a78" }
}

scripts: "scripts/processes — the only q that knows TorQ" {
  class: band
  label.near: bottom-right

  runners: "TorQ runners, built on .qtorq\ntorq_backfill · torq_stream\ntorq_tap" { class: adapter }
  standalone: "run_stream.q\nany streaming job\non plain kdb+" { class: fw }
}

stack: "Running stack — lib/torq, vendored" {
  class: band
  label.near: bottom-left

  tp: "stp1\ntickerplant" { class: runtime }
  store: "rdb1 · wdb1 · hdb1/2\nfed by stp1" { class: runtime }
  gw: "gateway1\nqueries rdb and hdb" { class: runtime }
}

py: "python/ · web/" {
  class: band

  web: "web/ — React\nCoverage · Backfills · Desk\nOps · Control" { class: py }
  bff: "uqf_frontend\nAPI · pooled gateway connections" { class: py }
  provider: "uqf_airflow_provider\nreads the status files" { class: py }
  uqs: "uqs\nCLI · MCP · starts stack and feeds" { class: py }

  web -> bff { style.stroke: "#6f4aa5" }
}

# ================================================================== edges

outside.live -> stack.tp: ".u.upd" { style.stroke: "#8a7f6a" }
outside.batch -> src.decls: "read per window" { style.stroke: "#8a7f6a" }
src.core -> scripts.runners: "run" { style.stroke: "#3d7a5a" }
src.core -> scripts.standalone: "run, TorQ-free" {
  style.stroke: "#3d7a5a"
  style.stroke-dash: 4
}
scripts.runners -> stack.tp: "subscribe · publish" {
  style.stroke: "#a54a5c"
  style.stroke-width: 3
}
outside.airflow -> scripts.runners: "triggers a window" { style.stroke: "#8a7f6a" }
outside.browser -> py.web: "HTTP" { style.stroke: "#8a7f6a" }
py.bff -> stack.gw: ".gw.syncexec" { style.stroke: "#6f4aa5" }
src.core -> py.provider: "status files" {
  style.stroke: "#6f4aa5"
  style.stroke-dash: 4
}
py.uqs -> stack: "starts · stops" {
  style.stroke: "#6f4aa5"
  style.stroke-dash: 4
}
