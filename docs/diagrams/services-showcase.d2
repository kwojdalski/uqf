# services-showcase.d2 - how the stack's processes differ, as a decision tree.
#
# Rendered by scripts/generate/render_diagrams.py, which CI runs with
# --check. Embedded from docs/services/README.md.
#
# WHAT THIS DIAGRAM IS FOR. The showcase lists every process; this sorts them
# by the two things that tell them apart: where their rows come from, and what
# they do with the tables they read. Each leaf names its processes with the
# tables they read and write, as the generated process table has them
# (docs/reference/processes.md) - so it can be checked, not just believed.
#
# The Databento and Kafka processes are the easy ones to misread: the
# PUBLISHER is a Python handler outside q (a q process cannot hold either
# subscription), and databento1 / kafka_flow1 are ordinary subscribers to the
# raw table it publishes. The drawing routes them through "from outside q"
# and back into the subscriber questions for that reason.
#
# VENDORED vs OURS. Every process in the tree is uqf's own; the dashed box on
# top is the TorQ Finance Starter Pack they run on (lib/, never edited) - its
# 23 processes, as docs/reference/processes.md lists them, and its three
# tables. A vendored table in a leaf is marked (TorQ): today that is `quote`,
# which fxfeed1 writes beside TorQ's own feed1.

direction: down

vars: {
  d2-config: {
    pad: 40
  }
}

classes: {
  question: {
    shape: diamond
    style: {
      fill: "#f3eefb"
      stroke: "#6f4aa5"
      font-color: "#3a1e5f"
    }
  }
  group: {
    style: {
      fill: "#eaf5ef"
      stroke: "#3d7a5a"
      font-color: "#1d4733"
      border-radius: 6
    }
  }
  external: {
    style: {
      fill: "#f6f0e6"
      stroke: "#a8762f"
      font-color: "#5c3f13"
      border-radius: 6
    }
  }
  bounded: {
    style: {
      fill: "#eef3fb"
      stroke: "#4a6a9a"
      font-color: "#1f3557"
      border-radius: 6
    }
  }
  vendored: {
    style: {
      fill: "#e9e9ee"
      stroke: "#55556a"
      font-color: "#26263a"
      border-radius: 6
      stroke-dash: 3
    }
  }
  quiet: {
    style: {
      fill: "#eef1f4"
      stroke: "#5a6a78"
      font-color: "#25323d"
      border-radius: 6
    }
  }
}

vendored: "VENDORED - TorQ Finance Starter Pack (lib/), never edited\n\ntickerplant: stp1, sctp1, tpreplay1\nstorage: rdb1, wdb1, hdb1, hdb2, sort1, sortworker1, sortworker2\nqueries: gateway1\nfleet: discovery1, monitor1, housekeeping1, killtick,\nreporter1, filealerter1, metrics1\ndata quality: dqc1, dqcdb1, dqe1, dqedb1\nits own demo feed: feed1 -> quote, trade (equities)\n\nits tables: quote, trade, packets - marked (TorQ) below" { class: vendored }

start: "A process in the stack -\nevery one below is uqf's own" { class: quiet }

vendored -> start: "they all run on it" { style.stroke-dash: 4 }

q_source: "Where do its rows\ncome from?" { class: question }

feeds: "FEEDS - invent rows on a timer\n\nfxfeed1 -> quote (TorQ)\nfxorderbookfeed1 -> fx_orderbook\nwidefeed1 -> wide_orderbook\nfxtradesfeed1 -> trades\nfxordersfeed1 -> orders\ncryptomock1 -> crypto_book, crypto_trades" { class: group }

external: "EXTERNAL PUBLISHERS - Python, outside q\n(q cannot hold these subscriptions)\n\ndatabento_feed.py -> databento_mbp10\nkafka_feed.py -> kafka_client_flow" { class: external }

backfills: "BACKFILLS - a past range, then exit\nrun on demand: uqs backfill ... [--wait]\n\na q process (IPC): deals, events, upstream,\nhdb_markouts (the stack's HDB)\nODBC / DuckDB: duckdb_deals, databento,\n crypto_market_data\nHDB files: hdb_transfer" { class: bounded }

q_publish: "Does it publish\nanything?" { class: question }

quiet_leaves: "WATCHERS - publish nothing\n\ntap1: Tickerplant inspector,\nlogs every batch it sees\ncross1: keeps cross rates from fx_orderbook\nas its own state" { class: quiet }

q_same: "Several tables that mean\nthe same thing, into\none shape?" { class: question }

normalizers: "NORMALIZERS - many sources, one table\n\nexecutions1: trades + crypto_trades + orders -> executions\nmarketdata1: quote (TorQ) + fx_orderbook + crypto_book -> market_data" { class: group }

q_join: "Does it combine several\ntables row by row?" { class: question }

joins: "JOINS - more than one input\n\nmarkout1: trades + quote (TorQ) -> demo_execution_quality\nposbook1: executions + market_data -> position" { class: group }

single: "ONE INPUT, ONE JOB\n\ndatabento1: databento_mbp10 -> eq_orderbook\nkafka_flow1: kafka_client_flow -> client_flow\nfxpositions1: executions -> fx_position, fx_limit_breach\nvectorize1: wide_orderbook -> mkt_orderbook\nsuperbook1: market_data -> superbook\narbitrage1: superbook -> arbitrage\ncrossarb1: superbook -> cross_arbitrage" { class: group }

start -> q_source
q_source -> feeds: "it makes them"
q_source -> external: "from outside q -\na venue or a broker"
q_source -> q_publish: "from tables already\non the tickerplant"
q_source -> backfills: "from a past range,\noutside the stack"

external -> q_publish: "a q job subscribes\nto the raw table" { style.stroke-dash: 4 }

q_publish -> quiet_leaves: "no" { style.stroke: "#6f4aa5" }
q_publish -> q_same: "yes" { style.stroke: "#6f4aa5" }
q_same -> normalizers: "yes" { style.stroke: "#6f4aa5" }
q_same -> q_join: "no" { style.stroke: "#6f4aa5" }
q_join -> joins: "yes" { style.stroke: "#6f4aa5" }
q_join -> single: "no" { style.stroke: "#6f4aa5" }
