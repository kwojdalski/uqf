# example-architecture.d2 - a desk system composed from what this tree
# implements.
#
# Rendered by scripts/generate/render_diagrams.py, which CI runs with
# --check. Embedded from docs/architecture/example-architecture.md.
#
# WHAT THIS IS AND IS NOT. Not the running demo - stack-topology.d2 and
# stack-dataflow.d2 draw that, with ports. This is the SHAPE a trading
# desk's system takes when it is built out of these services, read left to
# right: market data and fills come in from several sources in several
# shapes, are spelled one way, drive the engines that hold state, and
# reach people through the surfaces. Every box names what implements it.
#
# The two things worth seeing are the narrow waists. The first is the
# normalizers: everything above them arrives in its own market's format,
# everything below them sees one. The second is the plant: every engine
# reads from it and republishes onto it, so a new engine is a subscriber
# and never a change to a producer.
#
# Dashed boxes are in an open pull request, not on master.

direction: right

grid-rows: 1
grid-gap: 48

vars: {
  d2-config: {
    pad: 40
  }
}

classes: {
  source: {
    style: {
      fill: "#f6f0e6"
      stroke: "#a8762f"
      font-color: "#5c3f13"
      border-radius: 6
    }
  }
  job: {
    style: {
      fill: "#eaf5ef"
      stroke: "#3d7a5a"
      font-color: "#1d4733"
      border-radius: 6
    }
  }
  plant: {
    style: {
      fill: "#fbeef0"
      stroke: "#a54a5c"
      font-color: "#5f1f2c"
      border-radius: 6
    }
  }
  library: {
    style: {
      fill: "#eef3fb"
      stroke: "#4a6fa5"
      font-color: "#1e3a5f"
      border-radius: 6
    }
  }
  store: {
    style: {
      fill: "#eef1f4"
      stroke: "#5a6a78"
      font-color: "#25323d"
      border-radius: 6
    }
  }
  surface: {
    style: {
      fill: "#f4f1ea"
      stroke: "#8a7f6a"
      font-color: "#3d3527"
      border-radius: 6
    }
  }
  band: {
    style: {
      fill: "#fbfcfd"
      stroke: "#c3c9cf"
      font-color: "#25323d"
      stroke-width: 2
      border-radius: 10
    }
  }
}

sources: "1 · sources — each in its own shape" {
  class: band
  grid-columns: 1
  grid-gap: 14

  fx: "FX venue feeds\nfx_feed · quotes_feed · fx_trades_feed\n(synthetic here; a venue adapter in production)" { class: source }
  crypto: "crypto venues\ncryptorust's two kdb recorders,\nor crypto_mock standing in" { class: source }
  databento: "Databento MBP-10\ndatabento_feed.py → databento_book\nlive; the same fold as the ODBC backfill" { class: source }
  backfill: "history\nbounded workers over ODBC / upstream q\n.qbw · .qmatz coverage ledger · .qrun" { class: source }
}

plant: "2 · the plant" {
  class: band
  grid-columns: 1
  grid-gap: 14

  tp: "tickerplant\nTorQ stp1 in the stack —\nor .qtick on stock kdb+" { class: plant }
  storage: "rdb · hdb\ntoday in memory,\nEOD writedown to disk" { class: store }
}

normalize: "3 · normalizers — one shape from many (.qnorm)" {
  class: band
  grid-columns: 1
  grid-gap: 14

  executions: "executions\ntrades + crypto_trades\n→ one fill table" { class: job }
  marks: "marks\nquote + crypto_book\n→ one mid per instrument" { class: job }
  marketdata: "market_data\nquote + quotes\n→ one book shape" { class: job }
}

engines: "4 · engines — subscribe, hold state, republish" {
  class: band
  grid-columns: 1
  grid-gap: 14

  posbook: "posbook\n.qpos: position & P&L per sym\nmarked to marks, FX and crypto in one book" { class: job }
  fxpos: "fx_positions\n.qdesk: exposure by (sym, book, product)\n.qlimit: breaches, throttled" { class: job }
  markout: "markout\n.qexec: execution quality\nat horizons, on a timer" { class: job }
  cross: "cross · vectorize\n.qfwd synthetic crosses,\n.qbook reshaping" { class: job }
  superbook: "superbook · arbitrage · crossarb\n.qsuper merges quoted liquidity;\ncrossed levels and synthetic routes\nfall out of the merged book" { class: job }
}

analytics: "5 · on demand — pure, over whatever the store holds" {
  class: band
  grid-columns: 1
  grid-gap: 14

  alloc: ".qalloc\nP&L attribution: FIFO / LIFO /\nweighted, carried positions, as-of" { class: library }
  risk: ".qrisk · .qpos.ccy_exposure_in\nVaR, carry, per-currency\nexposure in a reporting ccy" { class: library }
  restate: "restatement\nbitemporal coverage: re-run a\nwindow, keep what it replaced" { class: library }
}

surfaces: "6 · surfaces" {
  class: band
  grid-columns: 1
  grid-gap: 14

  frontend: "uqf_frontend\nFastAPI + web: positions, coverage,\nfleet, control — through the gateway" { class: surface }
  airflow: "uqf_airflow_provider\nschedule backfills, sense\ntheir status files" { class: surface }
  client: "uqf_client · MCP\nkola IPC from Python;\nthe stack as tools" { class: surface }
}

sources.fx -> plant.tp
sources.crypto -> plant.tp
sources.databento -> plant.tp
sources.backfill -> plant.storage: "writes through .qio,\nnever via the plant"

plant.tp -> normalize.executions
plant.tp -> normalize.marks
normalize.executions -> plant.tp: "republish" { style.stroke-dash: 2 }
normalize.marks -> plant.tp: "republish" { style.stroke-dash: 2 }

plant.tp -> engines.posbook: "executions · marks"
plant.tp -> engines.fxpos: "orders"
plant.tp -> engines.markout: "trades · quote"
plant.tp -> engines.cross: "quotes · wide_book"

engines.posbook -> plant.tp: "position" { style.stroke-dash: 2 }
engines.fxpos -> plant.tp: "fx_position · fx_limit_breach" { style.stroke-dash: 2 }
engines.markout -> plant.tp: "execution_quality" { style.stroke-dash: 2 }

plant.tp -> plant.storage: "every table"

plant.storage -> analytics.alloc: "trades, any day"
plant.storage -> analytics.risk: "positions + quotes"
plant.storage -> analytics.restate: "coverage ledger"

plant.storage -> surfaces.frontend: "gateway queries"
analytics.alloc -> surfaces.frontend
sources.backfill -> surfaces.airflow: "status files" { style.stroke-dash: 2 }
plant.storage -> surfaces.client
