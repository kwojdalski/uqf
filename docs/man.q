// Generated qdoc tables to allow programmatic use of documentation.
.man.funcs:([] fullname:(); ns:(); description:(); name:(); other:());
.man.registerFunc:{`.man.funcs insert `fullname`ns`description`name`other!(),/:x};
.man.args:([] fullname:(); tag:(); param:(); description:());
.man.registerArg:{`.man.args insert `fullname`tag`param`description!(),/:x};
.man.files:([] title:(); author:(); namespaces:(); header:());
.man.registerFile:{`.man.files insert `title`author`namespaces`header!(),/:x};
.man.filetags:([] title:(); tag:(); val:());
.man.registerFileTag:{`.man.filetags insert `title`tag`val!(),/:x};

/ @eg .man.getDocs[]
/ @return table of format ([] fullname; tag; param; description)
.man.getDocs:{[]
    ft:select fullname,description from .man.funcs;
    at:select fullname,tag,param,description from .man.args;
    headerTbl:0!select description:"\n" sv header by title,fullname:{first "|" vs x} each namespaces from .man.files where 1<count each trim namespaces,1<count each trim header;
    filenameToNSDict:exec first fullname by title from headerTbl;
    tagTbl:select fullname:filenameToNSDict title, tag,description:val from .man.filetags;
    t:at uj ft uj tagTbl uj (``title _ headerTbl);
    t:asc select from t where (0<count each tag) or (0<count each param) or (0<count each description);
    t };



/ @eg .man.getTS[`GOOG]
.man.getTS:{[symbol]  // random walk with set seed to mimic incoming data
    seed:prd `int$string symbol;
    {  walk:{ [seed;n]
    	 r:{{ abs ((1664525*x)+1013904223) mod 4294967296}\[y-1;x]};
    	 prds (100+((r[seed;n]) mod 11)-5)%100};
    	 c:{x mod `long$00:20:00.0t}x;   st:x-c;   cn:`long$c%1000;
    	 ([] time:.z.d+st+1000*til cn; gold:walk[y;cn])  }[.z.t;seed]
    };

/ @eg .man.getOHLC[`MSFT]
.man.getOHLC:{[symbol]
    seed:prd `int$string symbol;
    {  r:{{ abs ((1664525*x)+1013904223) mod 4294967296}\[y-1;x]};
	walk:{ [r;seed;n] prds (100+((r[seed;n]) mod 11)-5)%100}[r;;];
	c:{x mod `long$00:05:00.0t}x;   st:x-c;   cn:100+`long$c%1000;
	t:([] time:`second$.z.d+st+1000*til cn; open:walk[y+4;cn]; close:walk[y+3;cn]);
	-100 sublist update low:?[open > close;close;open]-(r[11;cn] mod 11)*0.02,high:?[open < close;close;open]+(r[44;cn] mod 11)*0.02,volume:(r[44;cn] mod 110) from t}[.z.t;seed]
    };

/ @eg .man.getSymbols[]
.man.getSymbols:{[]
    sym:`MSFT`AAPL`NVDA`AMZN`GOOGL`META`BRK.B`AVGO`TSLA`TSM`WMT`JPM`V`LLY`MA`NFLX`XOM`COST`ORCL`JNJ`PG`HD`UNH`SAP`ABBV`BAC`KO`NVO;
    des:("Microsoft Corporation";"Apple Inc.";"NVIDIA Corporation";"Amazon.com, Inc.";"Alphabet Inc.";"Meta Platforms, Inc.";"Berkshire Hathaway Inc.";"Broadcom Inc.";"Tesla, Inc.";"Taiwan Semiconductor Manufacturing Company Limited";"Walmart Inc.";"JPMorgan Chase & Co.";"Visa Inc.";"Eli Lilly and Company";"Mastercard Incorporated";"Netflix, Inc.";"Exxon Mobil Corporation";"Costco Wholesale Corporation";"Oracle Corporation";"Johnson & Johnson";"The Procter & Gamble Company";"The Home Depot, Inc.";"UnitedHealth Group Incorporated";"SAP SE";"AbbVie Inc.";"Bank of America Corporation";"The Coca-Cola Company";"Novo Nordisk A/S");
    t:update query:(`$".man.getTS[`XXX]") from ([] symbol:sym; title:`$des);
    t,:select query:(`$".man.getOHLC[`XXX]"),symbol:(`$string[symbol],\:"_OHLC"),title from t;
    t};


.man.registerFile ("ccy.q";"";".qf";"ccy.q - currency pair symbol conventions: canonical CURCUR validation and normalization from looser input formats (lowercase, with separators). . Canonical form used throughout this library is CURCUR - six uppercase letters, no separator, e.g. `EURUSD (not `eurusd, not \"EUR/USD\").");
.man.registerFunc (".qf.ccy_pair_legs";".qf";"Split a currency pair (any reasonable format - normalized first) into its base and quote 3-letter currency codes.";".qf.ccy_pair_legs";".qf.ccy_pair_legs `EURUSD  -> `base`quote!(`EUR;`USD)");
.man.registerArg (".qf.ccy_pair_legs";"param";"pair";"a symbol or string, e.g. `EURUSD, \"eur/usd\"");
.man.registerArg (".qf.ccy_pair_legs";"eg";"";".qf.ccy_pair_legs `EURUSD  -> `base`quote!(`EUR;`USD)");
.man.registerArg (".qf.ccy_pair_legs";"throws";"";"error if pair cannot be normalized to a 6-letter CURCUR pair");
.man.registerArg (".qf.ccy_pair_legs";"return";"";"dict `base`quote!(baseSym;quoteSym)");
.man.registerFunc (".qf.ccy_pair_symbol";".qf";"Build a canonical CURCUR pair symbol from a 3-letter base and quote currency code.";".qf.ccy_pair_symbol";".qf.ccy_pair_symbol[`EUR;`USD]  -> `EURUSD");
.man.registerArg (".qf.ccy_pair_symbol";"param";"quote";"3-letter quote currency code, e.g. `USD or \"usd\"");
.man.registerArg (".qf.ccy_pair_symbol";"param";"base";"3-letter base currency code, e.g. `EUR or \"eur\"");
.man.registerArg (".qf.ccy_pair_symbol";"eg";"";".qf.ccy_pair_symbol[`EUR;`USD]  -> `EURUSD");
.man.registerArg (".qf.ccy_pair_symbol";"throws";"";"error if base or quote is not a 3-letter alphabetic code");
.man.registerArg (".qf.ccy_pair_symbol";"return";"";"the canonical CURCUR symbol, e.g. `EURUSD");
.man.registerFunc (".qf.ccy_to_str";".qf";"Private: string-coerce x without exploding an already-string input into a list of 1-char strings - `string` on a char vector maps over each char instead of acting as the identity, which is a real q gotcha.";".qf.ccy_to_str";".qf.ccy_to_str `EURUSD  -> \"EURUSD\"");
.man.registerArg (".qf.ccy_to_str";"param";"x";"a symbol or string");
.man.registerArg (".qf.ccy_to_str";"eg";"";".qf.ccy_to_str `EURUSD  -> \"EURUSD\"");
.man.registerArg (".qf.ccy_to_str";"return";"";"x as a plain string");
.man.registerFunc (".qf.is_ccy_pair";".qf";"True if x is already in canonical CURCUR form: exactly 6 uppercase letters, no separator.";".qf.is_ccy_pair";"");
.man.registerArg (".qf.is_ccy_pair";"eg";".qf.is_ccy_pair";"\"eur/usd\"  -> 0b");
.man.registerArg (".qf.is_ccy_pair";"param";"x";"a symbol or string");
.man.registerArg (".qf.is_ccy_pair";"return";"";"1b if x is a valid CURCUR pair, else 0b");
.man.registerFunc (".qf.normalize_ccy_pair";".qf";"Normalize a currency pair into canonical CURCUR form: uppercases and strips common separators (/, -, _, space).";".qf.normalize_ccy_pair";".qf.normalize_ccy_pair \"eur/usd\"  -> `EURUSD");
.man.registerArg (".qf.normalize_ccy_pair";"param";"x";"a symbol or string, e.g. `eurusd, \"EUR/USD\", \"eur-usd\"");
.man.registerArg (".qf.normalize_ccy_pair";"eg";"";".qf.normalize_ccy_pair \"eur/usd\"  -> `EURUSD");
.man.registerArg (".qf.normalize_ccy_pair";"throws";"";"error if x cannot be normalized to a 6-letter CURCUR pair");
.man.registerArg (".qf.normalize_ccy_pair";"return";"";"the canonical CURCUR symbol, e.g. `EURUSD");
.man.registerFile ("init.q";"";"";"init.q - loads every uqf module into the .qf namespace. Run from the repository root, e.g. `q src/init.q` or `\l src/init.q`.");
.man.registerFile ("execution.q";"";".qf";"execution.q - eFX execution-quality analytics: markouts, effective spread, slippage and quoting/fill statistics. . Sign convention used throughout: side is 1 for a client/algo buy (long base currency) and -1 for a sell. Every *cost* style metric (eff_spread, slippage) is positive when it went against the side taking the trade; markout is positive when the market moved in that side's favour after the trade (i.e. positive markout received by a client is \"toxic flow\" from a liquidity provider's point of view - flip side to view it from the LP's side of the same trade).");
.man.registerFunc (".qf.eff_spread";".qf";"Effective spread paid/received relative to the prevailing mid at the moment of execution, in pips. Positive = cost to the side that traded.";".qf.eff_spread";".qf.eff_spread[1;1.1002;1.1000;10000]  -> 4f");
.man.registerArg (".qf.eff_spread";"param";"mid_at_trade";"the mid price at the moment of execution");
.man.registerArg (".qf.eff_spread";"param";"side";"1 for a buy, -1 for a sell");
.man.registerArg (".qf.eff_spread";"param";"trade_price";"the execution price");
.man.registerArg (".qf.eff_spread";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
.man.registerArg (".qf.eff_spread";"eg";"";".qf.eff_spread[1;1.1002;1.1000;10000]  -> 4f");
.man.registerArg (".qf.eff_spread";"return";"";"the effective spread, in pips");
.man.registerFunc (".qf.fill_ratio";".qf";"Fraction of quotes/orders that resulted in a fill.";".qf.fill_ratio";".qf.fill_ratio[73;100]  -> 0.73");
.man.registerArg (".qf.fill_ratio";"param";"num_fills";"number of filled orders");
.man.registerArg (".qf.fill_ratio";"param";"num_quotes";"number of quotes/orders sent");
.man.registerArg (".qf.fill_ratio";"eg";"";".qf.fill_ratio[73;100]  -> 0.73");
.man.registerArg (".qf.fill_ratio";"return";"";"the fill ratio, in [0,1]");
.man.registerFunc (".qf.markout";".qf";"Post-trade price movement: how far the reference/mid price has moved, in pips, from the trade price by the time ref_price was observed. ref_price may be a single price or a vector of prices at several horizons (t+1s, t+10s, t+60s, ...) - the function vectorises naturally.";".qf.markout";".qf.markout[1;1.1000;1.1010;10000]  -> 10f");
.man.registerArg (".qf.markout";"param";"side";"1 for a buy, -1 for a sell");
.man.registerArg (".qf.markout";"param";"trade_price";"the execution price");
.man.registerArg (".qf.markout";"param";"ref_price";"the reference/mid price at the markout horizon (atom or vector)");
.man.registerArg (".qf.markout";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
.man.registerArg (".qf.markout";"eg";"";".qf.markout[1;1.1000;1.1010;10000]  -> 10f");
.man.registerArg (".qf.markout";"return";"";"the markout, in pips");
.man.registerFunc (".qf.markout_at_horizons";".qf";"Markout at one or more time horizons after each trade, looking up the reference mid itself via an as-of join against a quote table - the table-native companion to markout, for when you have trades and quotes as tables rather than an already-aligned ref_price vector. For each trade and each horizon, finds the most recent quote at or before trade_time+horizon (same semantics as kdb+'s aj) and computes markout against its mid. A trade/horizon pair with no quote at or before the target time gets a null ref_price and a null markout_pips - filter with `where not null markout_pips` if you want to drop those rather than see them.";".qf.markout_at_horizons";".qf.markout_at_horizons[trades;quotes;0D00:00:01 0D00:00:10]");
.man.registerArg (".qf.markout_at_horizons";"param";"trades";"table with columns `sym`time`side`trade_price`pip_factor");
.man.registerArg (".qf.markout_at_horizons";"param";"quotes";"table with columns `sym`time`mid - need not be pre-sorted, this sorts its own copy before joining");
.man.registerArg (".qf.markout_at_horizons";"param";"horizons";"a timespan, or list of timespans, to look ahead from each trade's time, e.g. 0D00:00:01 0D00:00:10 0D00:01:00 for 1s/10s/1m");
.man.registerArg (".qf.markout_at_horizons";"eg";"";".qf.markout_at_horizons[trades;quotes;0D00:00:01 0D00:00:10]");
.man.registerArg (".qf.markout_at_horizons";"return";"";"a table with one row per (trade, horizon): `sym`trade_time`horizon`target_time`trade_price`ref_price`markout_pips");
.man.registerFunc (".qf.reject_ratio";".qf";"Fraction of trade requests rejected (e.g. under last look).";".qf.reject_ratio";".qf.reject_ratio[4;100]  -> 0.04");
.man.registerArg (".qf.reject_ratio";"param";"num_rejects";"number of rejected requests");
.man.registerArg (".qf.reject_ratio";"param";"num_requests";"total number of requests");
.man.registerArg (".qf.reject_ratio";"eg";"";".qf.reject_ratio[4;100]  -> 0.04");
.man.registerArg (".qf.reject_ratio";"return";"";"the reject ratio, in [0,1]");
.man.registerFunc (".qf.slippage";".qf";"Slippage between a decision/arrival price and the actual execution price, in pips. Positive = cost to the side that traded.";".qf.slippage";".qf.slippage[1;1.1000;1.1003;10000]  -> 3f");
.man.registerArg (".qf.slippage";"param";"arrival_price";"the decision/arrival price");
.man.registerArg (".qf.slippage";"param";"side";"1 for a buy, -1 for a sell");
.man.registerArg (".qf.slippage";"param";"exec_price";"the actual execution price");
.man.registerArg (".qf.slippage";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
.man.registerArg (".qf.slippage";"eg";"";".qf.slippage[1;1.1000;1.1003;10000]  -> 3f");
.man.registerArg (".qf.slippage";"return";"";"the slippage, in pips");
.man.registerFunc (".qf.sweep_price";".qf";"Walk a stack of order book levels to price a sweep of target_size: the blended price you'd get consuming best-to-worst levels until target_size is filled or the book runs out. Pass the ask side (best/lowest price first) to price a buy/sweep-the-offer, or the bid side (best/highest price first) to price a sell/sweep-the-bid - this function doesn't care which side it is, only that prices/sizes are already ordered best-first.";".qf.sweep_price";".qf.sweep_price[1.1000 1.1002 1.1005;1000000 1000000 2000000;3000000]  -> `avg_price`worst_price`filled_size`fully_filled!(1.100233;1.1005;3000000;1b)");
.man.registerArg (".qf.sweep_price";"param";"target_size";"the size you want to sweep");
.man.registerArg (".qf.sweep_price";"param";"sizes";"level sizes, same length as prices, aligned to the same levels");
.man.registerArg (".qf.sweep_price";"param";"prices";"level prices, best (most aggressive) first");
.man.registerArg (".qf.sweep_price";"eg";"";".qf.sweep_price[1.1000 1.1002 1.1005;1000000 1000000 2000000;3000000]  -> `avg_price`worst_price`filled_size`fully_filled!(1.100233;1.1005;3000000;1b)");
.man.registerArg (".qf.sweep_price";"throws";"";"error if target_size is not positive, or prices/sizes differ in length");
.man.registerArg (".qf.sweep_price";"return";"";"dict `avg_price`worst_price`filled_size`fully_filled - avg_price is the size-weighted blended execution price (null if nothing filled), worst_price is the price of the last level touched (the marginal fill, null if nothing filled), filled_size is how much actually filled (may be less than target_size if the book doesn't have enough depth), and fully_filled is 1b iff filled_size>=target_size");
.man.registerFunc (".qf.vwap";".qf";"Size-weighted average execution price across a set of fills.";".qf.vwap";".qf.vwap[1.1000 1.1010 1.1005;1000000 2000000 1000000]  -> 1.100625");
.man.registerArg (".qf.vwap";"param";"sizes";"list of fill sizes, same length as prices");
.man.registerArg (".qf.vwap";"param";"prices";"list of fill prices");
.man.registerArg (".qf.vwap";"eg";"";".qf.vwap[1.1000 1.1010 1.1005;1000000 2000000 1000000]  -> 1.100625");
.man.registerArg (".qf.vwap";"return";"";"the size-weighted average price");
.man.registerFile ("rates.q";"";".qf";"rates.q - discount/growth factors and compounding conversions. t is a year fraction (see daycount.q), r a decimal annual rate (0.05 = 5%). .");
.man.registerFunc (".qf.cont_to_simple";".qf";"Convert a continuously compounded rate to the equivalent simple rate over the same period t.";".qf.cont_to_simple";".qf.cont_to_simple[0.04879016;1]  -> 0.05");
.man.registerArg (".qf.cont_to_simple";"param";"r";"continuously compounded decimal annual rate");
.man.registerArg (".qf.cont_to_simple";"param";"t";"year fraction");
.man.registerArg (".qf.cont_to_simple";"eg";"";".qf.cont_to_simple[0.04879016;1]  -> 0.05");
.man.registerArg (".qf.cont_to_simple";"return";"";"the simple rate with the same growth over t");
.man.registerFunc (".qf.df_cont";".qf";"Continuous-compounding discount factor.";".qf.df_cont";".qf.df_cont[0.05;1]  -> 0.9512294");
.man.registerArg (".qf.df_cont";"param";"r";"decimal annual rate");
.man.registerArg (".qf.df_cont";"param";"t";"year fraction");
.man.registerArg (".qf.df_cont";"eg";"";".qf.df_cont[0.05;1]  -> 0.9512294");
.man.registerArg (".qf.df_cont";"return";"";"exp(-r*t)");
.man.registerFunc (".qf.df_simple";".qf";"Simple-compounding discount factor.";".qf.df_simple";".qf.df_simple[0.05;1]  -> 0.952381");
.man.registerArg (".qf.df_simple";"param";"r";"decimal annual rate");
.man.registerArg (".qf.df_simple";"param";"t";"year fraction");
.man.registerArg (".qf.df_simple";"eg";"";".qf.df_simple[0.05;1]  -> 0.952381");
.man.registerArg (".qf.df_simple";"return";"";"1/(1+r*t)");
.man.registerFunc (".qf.growth_cont";".qf";"Continuous-compounding growth factor.";".qf.growth_cont";".qf.growth_cont[0.05;1]  -> 1.051271");
.man.registerArg (".qf.growth_cont";"param";"r";"decimal annual rate");
.man.registerArg (".qf.growth_cont";"param";"t";"year fraction");
.man.registerArg (".qf.growth_cont";"eg";"";".qf.growth_cont[0.05;1]  -> 1.051271");
.man.registerArg (".qf.growth_cont";"return";"";"exp(r*t)");
.man.registerFunc (".qf.growth_simple";".qf";"Simple-compounding growth factor.";".qf.growth_simple";".qf.growth_simple[0.05;1]  -> 1.05");
.man.registerArg (".qf.growth_simple";"param";"r";"decimal annual rate");
.man.registerArg (".qf.growth_simple";"param";"t";"year fraction");
.man.registerArg (".qf.growth_simple";"eg";"";".qf.growth_simple[0.05;1]  -> 1.05");
.man.registerArg (".qf.growth_simple";"return";"";"1+r*t");
.man.registerFunc (".qf.simple_to_cont";".qf";"Convert a simple-compounded rate to the equivalent continuously compounded rate over the same period t.";".qf.simple_to_cont";".qf.simple_to_cont[0.05;1]  -> 0.04879016");
.man.registerArg (".qf.simple_to_cont";"param";"r";"simple decimal annual rate");
.man.registerArg (".qf.simple_to_cont";"param";"t";"year fraction");
.man.registerArg (".qf.simple_to_cont";"eg";"";".qf.simple_to_cont[0.05;1]  -> 0.04879016");
.man.registerArg (".qf.simple_to_cont";"return";"";"the continuously compounded rate with the same growth over t");
.man.registerFile ("options.q";"";".qf";"options.q - Garman-Kohlhagen pricing for European FX vanilla options. . s = spot, k = strike, rd = domestic (quote-currency) risk-free rate, rf = foreign (base-currency) risk-free rate, sigma = volatility (decimal, e.g. 0.10 = 10%), t = year fraction to expiry. Setting rf=0 reduces the model to plain Black-Scholes. . Requires stats.q (ncdf/npdf) and rates.q (df_cont) to be loaded first.");
.man.registerFunc (".qf.bisect_vol";".qf";"Private: bisection search used as a robust fallback for implied_vol when Newton-Raphson stalls (vega ~ 0). gk_price is monotone increasing in sigma, so bisection over a wide bracket always converges.";".qf.bisect_vol";".qf.bisect_vol[0.03781082;1.10;1.12;0.045;0.02;0.75;1b]  -> 0.1 (approx)");
.man.registerArg (".qf.bisect_vol";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.bisect_vol";"param";"s";"spot rate");
.man.registerArg (".qf.bisect_vol";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.bisect_vol";"param";"t";"year fraction to expiry");
.man.registerArg (".qf.bisect_vol";"param";"price";"observed option premium");
.man.registerArg (".qf.bisect_vol";"param";"is_call";"1b for a call, 0b for a put");
.man.registerArg (".qf.bisect_vol";"param";"k";"strike");
.man.registerArg (".qf.bisect_vol";"eg";"";".qf.bisect_vol[0.03781082;1.10;1.12;0.045;0.02;0.75;1b]  -> 0.1 (approx)");
.man.registerArg (".qf.bisect_vol";"return";"";"sigma such that gk_price[...;sigma;...;is_call] ~ price");
.man.registerFunc (".qf.d1";".qf";"The Garman-Kohlhagen d1 term.";".qf.d1";".qf.d1[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.05174784");
.man.registerArg (".qf.d1";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qf.d1";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.d1";"param";"s";"spot rate");
.man.registerArg (".qf.d1";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.d1";"param";"t";"year fraction to expiry");
.man.registerArg (".qf.d1";"param";"k";"strike");
.man.registerArg (".qf.d1";"eg";"";".qf.d1[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.05174784");
.man.registerArg (".qf.d1";"return";"";"the Garman-Kohlhagen d1 term");
.man.registerFunc (".qf.d1_d2";".qf";"Private: (d1;d2) computed together so callers never duplicate the underlying arithmetic (see src/stats.q for why that matters in q).";".qf.d1_d2";".qf.d1_d2[1.10;1.12;0.045;0.02;0.10;0.75]  -> (0.05174784;-0.0348547)");
.man.registerArg (".qf.d1_d2";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qf.d1_d2";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.d1_d2";"param";"s";"spot rate");
.man.registerArg (".qf.d1_d2";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.d1_d2";"param";"t";"year fraction to expiry");
.man.registerArg (".qf.d1_d2";"param";"k";"strike");
.man.registerArg (".qf.d1_d2";"eg";"";".qf.d1_d2[1.10;1.12;0.045;0.02;0.10;0.75]  -> (0.05174784;-0.0348547)");
.man.registerArg (".qf.d1_d2";"return";"";"(d1;d2)");
