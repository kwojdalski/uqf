.man.registerArg (".qopt.gk_delta_call";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.gk_delta_call";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_delta_call";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_delta_call";"return";"";"the call delta, in (0, exp(-rf*t))");
.man.registerArg (".qopt.gk_delta_call";"eg";"";".qopt.gk_delta_call[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.512884");
.man.registerFunc (".qopt.gk_delta_put";".qopt";"Put delta: sensitivity of the premium to a change in spot.";".qopt.gk_delta_put";".qopt.gk_delta_put[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.4722279");
.man.registerArg (".qopt.gk_delta_put";"param";"s";"spot rate");
.man.registerArg (".qopt.gk_delta_put";"param";"k";"strike");
