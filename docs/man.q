.man.registerArg (".qopt.gk_gamma";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.gk_gamma";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.gk_gamma";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_gamma";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_gamma";"return";"";"gamma (always positive)");
.man.registerArg (".qopt.gk_gamma";"eg";"";".qopt.gk_gamma[1.10;1.12;0.045;0.02;0.10;0.75]  -> 4.11994");
.man.registerFunc (".qopt.gk_vega";".qopt";"Vega: sensitivity of the premium to a 1.00 (100%) change in vol. Identical for call and put; divide by 100 for the usual \"per vol point\" desk convention.";".qopt.gk_vega";".qopt.gk_vega[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.3738845");
.man.registerArg (".qopt.gk_vega";"param";"s";"spot rate");
.man.registerArg (".qopt.gk_vega";"param";"k";"strike");
.man.registerArg (".qopt.gk_vega";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.gk_vega";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.gk_vega";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_vega";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_vega";"return";"";"vega (always positive)");
.man.registerArg (".qopt.gk_vega";"eg";"";".qopt.gk_vega[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.3738845");
.man.registerFunc (".qopt.gk_vanna";".qopt";"Vanna: sensitivity of delta to vol, equivalently of vega to spot (d2V/dS dsigma). Identical for call and put, like gamma and vega - it is a second cross-derivative of the premium and carries no option-type term. Drives risk-reversal hedging, and is one of the two inputs the vanna-volga method needs alongside volga. Sign: opposite to d2, since vanna is -df*npdf[d1]*d2/sigma and both the discount factor and the density are positive. So vanna is negative for strikes below the forward and positive above it.";".qopt.gk_vanna";".qopt.gk_vanna[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.1367967");
.man.registerArg (".qopt.gk_vanna";"param";"s";"spot rate");
.man.registerArg (".qopt.gk_vanna";"param";"k";"strike");
.man.registerArg (".qopt.gk_vanna";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.gk_vanna";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.gk_vanna";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_vanna";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_vanna";"return";"";"vanna");
.man.registerArg (".qopt.gk_vanna";"eg";"";".qopt.gk_vanna[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.1367967");
.man.registerFunc (".qopt.gk_volga";".qopt";"Volga (vomma): sensitivity of vega to vol (d2V/dsigma2). Identical for call and put. Drives butterfly hedging, and is the second vanna-volga input. Sign follows d1*d2: negative only in the narrow band where d1 and d2 straddle zero (close to the vol-maximising strike), positive on both wings. Verified across k=1.00..1.40 at s=1.10: negative at k=1.12 alone, positive either side. That is why a butterfly, long the wings, is long volga.";".qopt.gk_volga";".qopt.gk_volga[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.006743588");
.man.registerArg (".qopt.gk_volga";"param";"s";"spot rate");
.man.registerArg (".qopt.gk_volga";"param";"k";"strike");
.man.registerArg (".qopt.gk_volga";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.gk_volga";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.gk_volga";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_volga";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_volga";"return";"";"volga");
.man.registerArg (".qopt.gk_volga";"eg";"";".qopt.gk_volga[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.006743588");
.man.registerFunc (".qopt.gk_theta_call";".qopt";"Call theta: time decay per year (-dV/dT); divide by 365 for a per-calendar-day figure.";".qopt.gk_theta_call";".qopt.gk_theta_call[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.03732846");
.man.registerArg (".qopt.gk_theta_call";"param";"s";"spot rate");
