.man.registerFunc (".qopt.gk_price";".qopt";"Private: dispatch to gk_call/gk_put by an is_call boolean.";".qopt.gk_price";".qopt.gk_price[1.10;1.12;0.045;0.02;0.10;0.75;1b]  -> 0.03781082");
.man.registerArg (".qopt.gk_price";"param";"s";"spot rate");
