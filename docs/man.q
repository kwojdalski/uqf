.man.registerArg (".qf.carry_return";"return";"";"the decimal forward premium/discount");
.man.registerFunc (".qf.pip_value";".qf";"Money value of a 1-pip move on a given base-currency notional, in quote currency.";".qf.pip_value";".qf.pip_value[1000000;10000]  -> 100f");
.man.registerArg (".qf.pip_value";"param";"notional";"position size in base currency units");
.man.registerArg (".qf.pip_value";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
