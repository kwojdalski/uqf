.man.registerFunc (".qopt.gk_rho_call";".qopt";"Call rho: sensitivity to the domestic rate rd.";".qopt.gk_rho_call";".qopt.gk_rho_call[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.3947712");
