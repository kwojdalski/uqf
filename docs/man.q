.man.registerFile ("risk.q";"";".qf";"risk.q - position-level P&L, carry and Value-at-Risk helpers for an FX book. Requires stats.q (inv_ncdf) to be loaded first for var_parametric. .");
.man.registerFunc (".qf.carry_pnl";".qf";"Money value of that same forward premium/discount on a given notional.";".qf.carry_pnl";".qf.carry_pnl[1000000;1.10;1.1050]  -> 5000f");
.man.registerArg (".qf.carry_pnl";"param";"notional";"position size in base currency units");
