.man.registerFunc (".qopt.BISECT_VOL_LO";".qopt";"Configurable search bracket/iteration cap for bisect_vol's fallback search - lo/hi should stay well outside any real-world vol (0.001% to 500%), wide enough that gk_price[lo] < price < gk_price[hi] always holds for a genuine premium. max_iter=200 over that bracket already gets sigma's precision down to (hi-lo)/2^200, far past float64 - the cap exists to bound worst-case work, not because convergence is in doubt. Override before calling if a narrower/wider bracket fits your instrument universe better, e.g. .qopt.BISECT_VOL_HI:2.0.";".qopt.BISECT_VOL_LO";"");
.man.registerFunc (".qopt.BISECT_VOL_HI";".qopt";"Configurable search bracket/iteration cap for bisect_vol's fallback search - lo/hi should stay well outside any real-world vol (0.001% to 500%), wide enough that gk_price[lo] < price < gk_price[hi] always holds for a genuine premium. max_iter=200 over that bracket already gets sigma's precision down to (hi-lo)/2^200, far past float64 - the cap exists to bound worst-case work, not because convergence is in doubt. Override before calling if a narrower/wider bracket fits your instrument universe better, e.g. .qopt.BISECT_VOL_HI:2.0.";".qopt.BISECT_VOL_HI";"");
.man.registerFunc (".qopt.BISECT_VOL_MAX_ITER";".qopt";"Configurable search bracket/iteration cap for bisect_vol's fallback search - lo/hi should stay well outside any real-world vol (0.001% to 500%), wide enough that gk_price[lo] < price < gk_price[hi] always holds for a genuine premium. max_iter=200 over that bracket already gets sigma's precision down to (hi-lo)/2^200, far past float64 - the cap exists to bound worst-case work, not because convergence is in doubt. Override before calling if a narrower/wider bracket fits your instrument universe better, e.g. .qopt.BISECT_VOL_HI:2.0.";".qopt.BISECT_VOL_MAX_ITER";"");
.man.registerFunc (".qopt.bisect_vol";".qopt";"Private: bisection search used as a robust fallback for implied_vol when Newton-Raphson stalls (vega ~ 0). gk_price is monotone increasing in sigma, so bisection over a wide bracket always converges.";".qopt.bisect_vol";".qopt.bisect_vol[0.03781082;1.10;1.12;0.045;0.02;0.75;1b]  -> 0.09999999 (0.1 to the eye. The residual is the bisection's own tolerance, so the exact digits are a property of BISECT_VOL_TOL rather than of the option)");
.man.registerArg (".qopt.bisect_vol";"param";"price";"observed option premium");
.man.registerArg (".qopt.bisect_vol";"param";"s";"spot rate");
.man.registerArg (".qopt.bisect_vol";"param";"k";"strike");
.man.registerArg (".qopt.bisect_vol";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.bisect_vol";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.bisect_vol";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.bisect_vol";"param";"is_call";"1b for a call, 0b for a put");
.man.registerArg (".qopt.bisect_vol";"return";"";"sigma such that gk_price[...;sigma;...;is_call] ~ price");
.man.registerArg (".qopt.bisect_vol";"eg";"";".qopt.bisect_vol[0.03781082;1.10;1.12;0.045;0.02;0.75;1b]  -> 0.09999999 (0.1 to the eye. The residual is the bisection's own tolerance, so the exact digits are a property of BISECT_VOL_TOL rather than of the option)");
.man.registerFunc (".qopt.IMPLIED_VOL_INITIAL_SIGMA";".qopt";"Configurable Newton-Raphson tuning for implied_vol - a 20% initial guess is a reasonable central starting point across FX vol regimes; price_tol/max_iter bound how precisely/how long NR is allowed to chase convergence before accepting whatever it has; vega_floor is the point below which NR's sigma step (diff%vega) would blow up, so it hands off to bisect_vol instead; sigma_floor keeps a single NR step from driving sigma negative or to exactly 0 (where vega is itself 0). Override before calling if your instruments need tighter/looser convergence, e.g. .qopt.IMPLIED_VOL_PRICE_TOL:1e-6 for faster, coarser fits.";".qopt.IMPLIED_VOL_INITIAL_SIGMA";"");
.man.registerFunc (".qopt.IMPLIED_VOL_MAX_ITER";".qopt";"Configurable Newton-Raphson tuning for implied_vol - a 20% initial guess is a reasonable central starting point across FX vol regimes; price_tol/max_iter bound how precisely/how long NR is allowed to chase convergence before accepting whatever it has; vega_floor is the point below which NR's sigma step (diff%vega) would blow up, so it hands off to bisect_vol instead; sigma_floor keeps a single NR step from driving sigma negative or to exactly 0 (where vega is itself 0). Override before calling if your instruments need tighter/looser convergence, e.g. .qopt.IMPLIED_VOL_PRICE_TOL:1e-6 for faster, coarser fits.";".qopt.IMPLIED_VOL_MAX_ITER";"");
.man.registerFunc (".qopt.IMPLIED_VOL_PRICE_TOL";".qopt";"Configurable Newton-Raphson tuning for implied_vol - a 20% initial guess is a reasonable central starting point across FX vol regimes; price_tol/max_iter bound how precisely/how long NR is allowed to chase convergence before accepting whatever it has; vega_floor is the point below which NR's sigma step (diff%vega) would blow up, so it hands off to bisect_vol instead; sigma_floor keeps a single NR step from driving sigma negative or to exactly 0 (where vega is itself 0). Override before calling if your instruments need tighter/looser convergence, e.g. .qopt.IMPLIED_VOL_PRICE_TOL:1e-6 for faster, coarser fits.";".qopt.IMPLIED_VOL_PRICE_TOL";"");
.man.registerFunc (".qopt.IMPLIED_VOL_VEGA_FLOOR";".qopt";"Configurable Newton-Raphson tuning for implied_vol - a 20% initial guess is a reasonable central starting point across FX vol regimes; price_tol/max_iter bound how precisely/how long NR is allowed to chase convergence before accepting whatever it has; vega_floor is the point below which NR's sigma step (diff%vega) would blow up, so it hands off to bisect_vol instead; sigma_floor keeps a single NR step from driving sigma negative or to exactly 0 (where vega is itself 0). Override before calling if your instruments need tighter/looser convergence, e.g. .qopt.IMPLIED_VOL_PRICE_TOL:1e-6 for faster, coarser fits.";".qopt.IMPLIED_VOL_VEGA_FLOOR";"");
.man.registerFunc (".qopt.IMPLIED_VOL_SIGMA_FLOOR";".qopt";"Configurable Newton-Raphson tuning for implied_vol - a 20% initial guess is a reasonable central starting point across FX vol regimes; price_tol/max_iter bound how precisely/how long NR is allowed to chase convergence before accepting whatever it has; vega_floor is the point below which NR's sigma step (diff%vega) would blow up, so it hands off to bisect_vol instead; sigma_floor keeps a single NR step from driving sigma negative or to exactly 0 (where vega is itself 0). Override before calling if your instruments need tighter/looser convergence, e.g. .qopt.IMPLIED_VOL_PRICE_TOL:1e-6 for faster, coarser fits.";".qopt.IMPLIED_VOL_SIGMA_FLOOR";"");
.man.registerFunc (".qopt.implied_vol";".qopt";"Implied volatility via Newton-Raphson (vega as derivative), falling back to bisection if vega collapses.";".qopt.implied_vol";".qopt.implied_vol[.qopt.gk_call[1.10;1.12;0.045;0.02;0.12;0.75];1.10;1.12;0.045;0.02;0.75;1b]  -> 0.12");
.man.registerArg (".qopt.implied_vol";"param";"price";"observed option premium");
.man.registerArg (".qopt.implied_vol";"param";"s";"spot rate");
.man.registerArg (".qopt.implied_vol";"param";"k";"strike");
.man.registerArg (".qopt.implied_vol";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.implied_vol";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.implied_vol";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.implied_vol";"param";"is_call";"1b for a call, 0b for a put");
.man.registerArg (".qopt.implied_vol";"return";"";"sigma such that gk_price[...;sigma;...;is_call] ~ price");
.man.registerArg (".qopt.implied_vol";"eg";"";".qopt.implied_vol[.qopt.gk_call[1.10;1.12;0.045;0.02;0.12;0.75];1.10;1.12;0.045;0.02;0.75;1b]  -> 0.12");
