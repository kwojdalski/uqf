.man.registerArg (".qf.pip_value";"return";"";"the value of a 1-pip move, in quote currency");
.man.registerFunc (".qf.pnl";".qf";"Mark-to-market P&L of a spot position, in quote currency.";".qf.pnl";".qf.pnl[1000000;1.1000;1.1050;1]  -> 5000f");
.man.registerArg (".qf.pnl";"param";"notional";"position size in base currency units");
