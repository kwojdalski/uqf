.man.registerFunc (".qf.carry_return";".qf";"Forward premium/discount implied by spot vs. an outright, as a decimal return: (F-S)/S. Positive means the base currency trades forward at a premium (i.e. rf is below rd under CIRP).";".qf.carry_return";".qf.carry_return[1.10;1.1050]  -> 0.004545455");
.man.registerArg (".qf.carry_return";"param";"fwd";"outright forward rate");
