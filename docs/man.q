.man.registerArg (".qf.pnl";"return";"";"the P&L, in quote currency");
.man.registerFunc (".qf.var_historical";".qf";"Historical simulation VaR: the magnitude of the (1-confidence) empirical percentile of a series of historical P&L outcomes.";".qf.var_historical";".qf.var_historical[-100+til 200;0.95]  -> 90 (5th percentile of a 200-outcome series)");
.man.registerArg (".qf.var_historical";"param";"pnl_series";"a list of historical P&L outcomes");
.man.registerArg (".qf.var_historical";"param";"confidence";"one-tailed confidence level, e.g. 0.95 or 0.99");
.man.registerArg (".qf.var_historical";"eg";"";".qf.var_historical[-100+til 200;0.95]  -> 90 (5th percentile of a 200-outcome series)");
.man.registerArg (".qf.var_historical";"return";"";"a positive loss estimate, in the same units as pnl_series");
.man.registerFunc (".qf.var_parametric";".qf";"One-sided parametric (variance-covariance) VaR for a position with annualised volatility vol over a horizon of t years, at a one-tailed confidence level (e.g. 0.95, 0.99).";".qf.var_parametric";".qf.var_parametric[1000000;0.10;1%252;0.95]  -> 10361.6 (1-day 95% VaR)");
.man.registerArg (".qf.var_parametric";"param";"notional";"position size (sign ignored - VaR is a loss magnitude)");
.man.registerArg (".qf.var_parametric";"param";"vol";"annualised volatility, decimal (0.10 = 10%)");
.man.registerArg (".qf.var_parametric";"param";"t";"horizon, year fraction (e.g. 1%252 for one trading day)");
.man.registerArg (".qf.var_parametric";"param";"confidence";"one-tailed confidence level, e.g. 0.95 or 0.99");
.man.registerArg (".qf.var_parametric";"eg";"";".qf.var_parametric[1000000;0.10;1%252;0.95]  -> 10361.6 (1-day 95% VaR)");
.man.registerArg (".qf.var_parametric";"return";"";"a positive loss estimate, in the notional's currency");
.man.registerFile ("data.q";"";".uqfdata";"data.q - optional Databento parquet data access, keyed by symbol and date. Not loaded by src/init.q: it needs a real kdb+/KDB-X interpreter (PeachQ has no `2:`, so it can't load KX's native pq module) and a local .env pointing at the data. Load explicitly with `\l src/data.q`.  Expects DATABENTO_DATA_DIR (from a repo-root .env file, or the OS environment) to point at a folder laid out as: <DATABENTO_DATA_DIR>/<SYMBOL>/<SYMBOL>_<YYYY-MM-DD>_raw_mbp-10_us_hours.parquet .");
.man.registerFunc (".uqfdata.cfg";".uqfdata";"Look up a config value: the OS environment first, then the parsed .env dict, then the given default.";".uqfdata.cfg";".uqfdata.cfg[`DATABENTO_DATA_DIR;::]");
.man.registerArg (".uqfdata.cfg";"param";"dflt";"fallback value, or generic null (::) to error if unset");
.man.registerArg (".uqfdata.cfg";"param";"k";"the variable name, e.g. `DATABENTO_DATA_DIR`");
.man.registerArg (".uqfdata.cfg";"eg";"";".uqfdata.cfg[`DATABENTO_DATA_DIR;::]");
.man.registerArg (".uqfdata.cfg";"throws";"";"configMissing if k isn't set anywhere and no default was given");
.man.registerArg (".uqfdata.cfg";"return";"";"the string value");
.man.registerFunc (".uqfdata.databentoDir";".uqfdata";"Root folder for locally-available Databento parquet dumps (DATABENTO_DATA_DIR), one subfolder per symbol.";".uqfdata.databentoDir";".uqfdata.databentoDir[]");
.man.registerArg (".uqfdata.databentoDir";"eg";"";".uqfdata.databentoDir[]");
.man.registerArg (".uqfdata.databentoDir";"throws";"";"configMissing if DATABENTO_DATA_DIR isn't set anywhere");
.man.registerArg (".uqfdata.databentoDir";"return";"";"the configured folder path, as a string");
.man.registerFunc (".uqfdata.databentoFile";".uqfdata";"Expected path to one symbol/date's daily Databento MBP-10 parquet file.";".uqfdata.databentoFile";".uqfdata.databentoFile[`AAPL;2026.02.25]");
.man.registerArg (".uqfdata.databentoFile";"param";"date";"a q date, e.g. 2026.02.25");
.man.registerArg (".uqfdata.databentoFile";"param";"sym";"ticker symbol, e.g. `AAPL`");
.man.registerArg (".uqfdata.databentoFile";"eg";"";".uqfdata.databentoFile[`AAPL;2026.02.25]");
.man.registerArg (".uqfdata.databentoFile";"return";"";"an hsym (file symbol) - the file need not exist yet");
.man.registerFunc (".uqfdata.env";".uqfdata";"Parsed contents of the repo-root .env file, if present - see parseEnv.";".uqfdata.env";"");
.man.registerFunc (".uqfdata.getBySymbolDate";".uqfdata";"Open one symbol/date's Databento parquet file as a lazy, row-group-pruned virtual table (via pqModule) - select from it like a normal table, e.g. select avg price by 1 xbar ts_event.minute from .uqfdata.getBySymbolDate[`AAPL;2026.02.25]";".uqfdata.getBySymbolDate";".uqfdata.getBySymbolDate[`AAPL;2026.02.25]");
.man.registerArg (".uqfdata.getBySymbolDate";"param";"date";"a q date, e.g. 2026.02.25");
.man.registerArg (".uqfdata.getBySymbolDate";"param";"sym";"ticker symbol, e.g. `AAPL`");
.man.registerArg (".uqfdata.getBySymbolDate";"eg";"";".uqfdata.getBySymbolDate[`AAPL;2026.02.25]");
.man.registerArg (".uqfdata.getBySymbolDate";"throws";"";"fileNotFound if no file exists for that symbol/date");
.man.registerArg (".uqfdata.getBySymbolDate";"return";"";"a virtual table handle over the matching parquet file");
.man.registerFunc (".uqfdata.parseEnv";".uqfdata";"Parse a .env-style file (KEY=VALUE lines; blank lines and lines starting with `#` are ignored) into a dict. Missing file -> empty dict, so this is safe to call unconditionally at load time.";".uqfdata.parseEnv";".uqfdata.parseEnv[`:.env]");
.man.registerArg (".uqfdata.parseEnv";"param";"file";"the .env file to parse, e.g. `:.env`");
.man.registerArg (".uqfdata.parseEnv";"eg";"";".uqfdata.parseEnv[`:.env]");
.man.registerArg (".uqfdata.parseEnv";"return";"";"a symbol!string dict of the parsed key/value pairs");
.man.registerFunc (".uqfdata.pqModule";".uqfdata";"";".uqfdata.pqModule";"");
.man.registerFunc (".uqfdata.pqm";".uqfdata";"KX's official pq module (github kx.com KDB-X distribution), loaded and memoized on first use rather than at file-load time, so simply loading data.q doesn't require a module-capable interpreter.";".uqfdata.pqm";".uqfdata.pqModule[][`pq]");
.man.registerArg (".uqfdata.pqm";"eg";"";".uqfdata.pqModule[][`pq]");
.man.registerArg (".uqfdata.pqm";"throws";"";"if `use` (KDB-X's module loader) is unavailable - real kdb+/KDB-X is required here, not PeachQ");
.man.registerArg (".uqfdata.pqm";"return";"";"the pq module namespace, exposing `.pq` (open file), `.op`/`.rd` (low-level access)");
.man.registerFile ("daycount.q";"";".qf";"daycount.q - day count fraction conventions used to turn a pair of dates into the year fraction t consumed by rates.q / forwards.q / options.q. . NOTE ON q ARITHMETIC: q has no operator precedence (strictly right to left evaluation), so every mixed +/-/* expression below is built from explicitly parenthesised, named intermediate terms rather than dense one-liners - see src/stats.q for the bug this avoids.");
.man.registerFunc (".qf.dcf_30e_360";".qf";"30E/360 (Eurobond basis): each month treated as having 30 days. Day-of-month is capped at 30 for both dates (the simple European variant - it does not carry the US/NASD end-of-February special case).";".qf.dcf_30e_360";".qf.dcf_30e_360[2024.01.15;2024.02.15]  -> 0.08333333 (30/360)");
.man.registerArg (".qf.dcf_30e_360";"param";"d1";"start date");
.man.registerArg (".qf.dcf_30e_360";"param";"d2";"end date");
.man.registerArg (".qf.dcf_30e_360";"eg";"";".qf.dcf_30e_360[2024.01.15;2024.02.15]  -> 0.08333333 (30/360)");
.man.registerArg (".qf.dcf_30e_360";"return";"";"the 30E/360 year fraction between d1 and d2");
.man.registerFunc (".qf.dcf_act_360";".qf";"Actual/360: (d2-d1) actual calendar days, annualised on a 360-day year. Common for USD, EUR money-market and most FX deposit/forward calcs.";".qf.dcf_act_360";".qf.dcf_act_360[2024.01.01;2025.01.01]  -> 1.016667 (2024 is a leap year)");
.man.registerArg (".qf.dcf_act_360";"param";"d1";"start date");
.man.registerArg (".qf.dcf_act_360";"param";"d2";"end date");
.man.registerArg (".qf.dcf_act_360";"eg";"";".qf.dcf_act_360[2024.01.01;2025.01.01]  -> 1.016667 (2024 is a leap year)");
.man.registerArg (".qf.dcf_act_360";"return";"";"(d2-d1) actual days, divided by 360");
.man.registerFunc (".qf.dcf_act_365";".qf";"Actual/365 (Fixed): (d2-d1) actual calendar days, annualised on a 365-day year. Common for GBP money markets.";".qf.dcf_act_365";".qf.dcf_act_365[2023.01.01;2024.01.01]  -> 1f");
.man.registerArg (".qf.dcf_act_365";"param";"d1";"start date");
.man.registerArg (".qf.dcf_act_365";"param";"d2";"end date");
.man.registerArg (".qf.dcf_act_365";"eg";"";".qf.dcf_act_365[2023.01.01;2024.01.01]  -> 1f");
.man.registerArg (".qf.dcf_act_365";"return";"";"(d2-d1) actual days, divided by 365");
.man.registerFunc (".qf.year_frac";".qf";"Dispatch to a day count convention by name.";".qf.year_frac";".qf.year_frac[`act360;2024.01.01;2025.01.01]  -> 1.016667");
.man.registerArg (".qf.year_frac";"param";"conv";"one of `act360`act365`30e360");
.man.registerArg (".qf.year_frac";"param";"d1";"start date");
.man.registerArg (".qf.year_frac";"param";"d2";"end date");
.man.registerArg (".qf.year_frac";"eg";"";".qf.year_frac[`act360;2024.01.01;2025.01.01]  -> 1.016667");
.man.registerArg (".qf.year_frac";"throws";"";"error if conv is not one of the supported symbols");
.man.registerArg (".qf.year_frac";"return";"";"the year fraction between d1 and d2 under the chosen convention");
.man.registerFile ("stats.q";"";".qf";"stats.q - normal distribution helpers used throughout uqf. ncdf/npdf use the Abramowitz & Stegun 7.1.26 rational approximation to the error function (max absolute error ~1.5e-7). inv_ncdf uses Peter Acklam's rational approximation to the inverse standard normal CDF (max relative error ~1.15e-9), released by its author into the public domain. See: https://web.archive.org/web/20151030215612/http://home.online.no/~pjacklam/notes/invnorm/ .");
.man.registerFunc (".qf.PI";".qf";"The constant pi, used by npdf.";".qf.PI";"");
.man.registerFunc (".qf.horner_eval";".qf";"Evaluate a polynomial at x via Horner's method - the one place q's lack of operator precedence for hand-written Horner chains is worked out and tested, so no other formula in this repo has to re-derive it. See the kdb-q-conventions skill for why (`a*x+b` means `a*(x+b)` in q, not `(a*x)+b`, which silently broke early drafts of this function).";".qf.horner_eval";".qf.horner_eval[2 3 4;5]  -> 69 (i.e. 2*5*5+3*5+4)");
.man.registerArg (".qf.horner_eval";"param";"coeffs";"polynomial coefficients, highest degree first, constant term last (as in numpy.polyval)");
.man.registerArg (".qf.horner_eval";"param";"x";"the point to evaluate the polynomial at");
.man.registerArg (".qf.horner_eval";"eg";"";".qf.horner_eval[2 3 4;5]  -> 69 (i.e. 2*5*5+3*5+4)");
.man.registerArg (".qf.horner_eval";"return";"";"coeffs[0]*x^n + coeffs[1]*x^(n-1) + ... + coeffs[n]");
.man.registerFunc (".qf.inv_ncdf";".qf";"Inverse standard normal CDF (probit function).";".qf.inv_ncdf";".qf.inv_ncdf 0.95  -> 1.644854 (the one-tailed 95% z-score)");
.man.registerArg (".qf.inv_ncdf";"param";"p";"probability, strictly within (0,1); an atom or a list of atoms");
.man.registerArg (".qf.inv_ncdf";"eg";"";".qf.inv_ncdf 0.95  -> 1.644854 (the one-tailed 95% z-score)");
.man.registerArg (".qf.inv_ncdf";"throws";"";"error if any element of p is not strictly between 0 and 1");
.man.registerArg (".qf.inv_ncdf";"return";"";"x such that ncdf[x]~p");
.man.registerFunc (".qf.ncdf";".qf";"Standard normal cumulative distribution function N(x).";".qf.ncdf";".qf.ncdf 1.96  -> 0.9750022");
.man.registerArg (".qf.ncdf";"param";"x";"point(s) to evaluate at (atom or vector)");
.man.registerArg (".qf.ncdf";"eg";"";".qf.ncdf 1.96  -> 0.9750022");
.man.registerArg (".qf.ncdf";"return";"";"P(Z is at most x) for a standard normal Z");
.man.registerFunc (".qf.npdf";".qf";"Standard normal probability density function n(x).";".qf.npdf";".qf.npdf 0f  -> 0.3989423");
.man.registerArg (".qf.npdf";"param";"x";"point(s) to evaluate at (atom or vector)");
.man.registerArg (".qf.npdf";"eg";"";".qf.npdf 0f  -> 0.3989423");
.man.registerArg (".qf.npdf";"return";"";"the standard normal density at x");
.man.registerFile ("forwards.q";"";".qf";"forwards.q - FX forward/swap points via covered interest rate parity (CIRP), and rate/cross-rate helpers used on an eFX forwards desk. . Currency pair convention: a rate quoted BASE/QUOTE means 1 unit of BASE buys `rate` units of QUOTE (e.g. EURUSD 1.1000 -> 1 EUR = 1.10 USD). rd is the QUOTE currency's interest rate, rf the BASE currency's.");
.man.registerFunc (".qf.book_crossed";".qf";"True if a book is crossed (bid > ask) - a sanity check for synthetic books built from cross_book/combine_oriented_books.";".qf.book_crossed";".qf.book_crossed[`bid`ask!(1.1000;1.1002)]  -> 0b");
.man.registerArg (".qf.book_crossed";"param";"book";"a dict `bid`ask!(bidPx;askPx)");
.man.registerArg (".qf.book_crossed";"eg";"";".qf.book_crossed[`bid`ask!(1.1000;1.1002)]  -> 0b");
.man.registerArg (".qf.book_crossed";"return";"";"1b if bid>ask, else 0b");
.man.registerFunc (".qf.ccy_orient_cross";".qf";"Private: work out how two currency pairs relate - which currency they share, what the resulting cross pair's symbol is, and whether either leg needs inverting before combining - without touching any prices. Shared by cross_book and cross_book_at_sizes so the two can never disagree about orientation.";".qf.ccy_orient_cross";".qf.ccy_orient_cross[`EURUSD;`USDJPY]  -> `cross_sym`invert1`invert2!(`EURJPY;0b;0b)");
.man.registerArg (".qf.ccy_orient_cross";"param";"sym1";"currency pair for leg 1, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.ccy_orient_cross";"param";"sym2";"currency pair for leg 2, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.ccy_orient_cross";"eg";"";".qf.ccy_orient_cross[`EURUSD;`USDJPY]  -> `cross_sym`invert1`invert2!(`EURJPY;0b;0b)");
.man.registerArg (".qf.ccy_orient_cross";"throws";"";"error if sym1 and sym2 share no common currency");
.man.registerArg (".qf.ccy_orient_cross";"return";"";"dict `cross_sym`invert1`invert2 - cross_sym is the resulting pair symbol; invert1/invert2 say whether that leg's quote convention needs flipping (BASE/QUOTE -> QUOTE/BASE) before combining");
.man.registerFunc (".qf.combine_oriented_books";".qf";"Combine two order books that are already oriented A/B and B/C (i.e. the quote currency of the first leg matches the base currency of the second) into a top-of-book A/C book. Private building block for cross_book; call directly if you've already oriented the legs yourself.";".qf.combine_oriented_books";".qf.combine_oriented_books[`bid`ask!(1.1000;1.1002);`bid`ask!(150.00;150.02)]  -> `bid`ask!(165;165.052)");
.man.registerArg (".qf.combine_oriented_books";"param";"book_ab";"dict `bid`ask!(bidPx;askPx) quoted A/B");
.man.registerArg (".qf.combine_oriented_books";"param";"book_bc";"dict `bid`ask!(bidPx;askPx) quoted B/C");
.man.registerArg (".qf.combine_oriented_books";"eg";"";".qf.combine_oriented_books[`bid`ask!(1.1000;1.1002);`bid`ask!(150.00;150.02)]  -> `bid`ask!(165;165.052)");
.man.registerArg (".qf.combine_oriented_books";"return";"";"dict `bid`ask!(bidPx;askPx) quoted A/C");
.man.registerFunc (".qf.cross_book";".qf";"Build a synthetic top-of-book cross rate from two live order books on pairs that share a common currency, e.g. cross_book[`EURUSD;eurusd_book; `USDJPY;usdjpy_book] -> a synthetic EURJPY book. The shared currency is detected automatically and either leg is inverted as needed - the caller does not need to pre-orient anything. sym1/sym2 are normalized via ccy.q's ccy_pair_legs, so `eurusd, \"eur/usd\" etc. work too, not just canonical `EURUSD. Combines top-of-book only; it does not walk/net multiple depth levels of the underlying books - see cross_book_at_sizes for that.";".qf.cross_book";".qf.cross_book[`EURUSD;`bid`ask!(1.1000;1.1002);`USDJPY;`bid`ask!(150.00;150.02)]  -> `sym`bid`ask!(`EURJPY;165;165.052)");
.man.registerArg (".qf.cross_book";"param";"book2";"dict `bid`ask!(bidPx;askPx) quoted in sym2's own convention");
.man.registerArg (".qf.cross_book";"param";"book1";"dict `bid`ask!(bidPx;askPx) quoted in sym1's own convention");
.man.registerArg (".qf.cross_book";"param";"sym1";"currency pair for book1, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.cross_book";"param";"sym2";"currency pair for book2, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.cross_book";"eg";"";".qf.cross_book[`EURUSD;`bid`ask!(1.1000;1.1002);`USDJPY;`bid`ask!(150.00;150.02)]  -> `sym`bid`ask!(`EURJPY;165;165.052)");
.man.registerArg (".qf.cross_book";"throws";"";"error if sym1 and sym2 share no common currency");
.man.registerArg (".qf.cross_book";"return";"";"dict `sym`bid`ask!(cross_sym;bidPx;askPx) for the synthetic cross");
.man.registerFunc (".qf.cross_book_at_one_size";".qf";"Private: bid, ask and mid for a 2-leg cross at a single size. mid is the average of the swept cross bid and the swept cross ask at that size (not a separate sweep of its own).";".qf.cross_book_at_one_size";"");
.man.registerArg (".qf.cross_book_at_one_size";"param";"book2";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 2");
.man.registerArg (".qf.cross_book_at_one_size";"param";"book1";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 1");
.man.registerArg (".qf.cross_book_at_one_size";"param";"size";"the size to sweep, in leg 1's relevant currency");
.man.registerArg (".qf.cross_book_at_one_size";"param";"sym1";"currency pair for leg 1");
.man.registerArg (".qf.cross_book_at_one_size";"param";"sym2";"currency pair for leg 2");
.man.registerArg (".qf.cross_book_at_one_size";"return";"";"one row: dict `size`sym`bid`bid_filled_size`bid_fully_filled`ask`ask_filled_size`ask_fully_filled`mid");
.man.registerFunc (".qf.cross_book_at_sizes";".qf";"Depth-aware synthetic cross rate: like cross_book, but walks multi-level order book depth on both legs for each requested size, converting the notional hop-by-hop (leg 2 is swept at the bridge-currency amount leg 1's sweep actually produced), and returns only the sides you ask for. Each leg's book must supply real depth, not just top-of-book - see sweep_price's book shape.";".qf.cross_book_at_sizes";".qf.cross_book_at_sizes[`EURUSD;eurusd_book;`USDJPY;usdjpy_book;1000000 3000000;`bid`ask`mid]");
.man.registerArg (".qf.cross_book_at_sizes";"param";"book2";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 2, each level best-first");
.man.registerArg (".qf.cross_book_at_sizes";"param";"book1";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 1, each level best-first");
.man.registerArg (".qf.cross_book_at_sizes";"param";"sizes";"list of sizes to price, e.g. 1000000 2000000 5000000");
.man.registerArg (".qf.cross_book_at_sizes";"param";"sides";"subset of `bid`ask`mid to include in the result");
.man.registerArg (".qf.cross_book_at_sizes";"param";"sym1";"currency pair for leg 1, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.cross_book_at_sizes";"param";"sym2";"currency pair for leg 2, any format ccy.q's normalize_ccy_pair accepts");
.man.registerArg (".qf.cross_book_at_sizes";"eg";"";".qf.cross_book_at_sizes[`EURUSD;eurusd_book;`USDJPY;usdjpy_book;1000000 3000000;`bid`ask`mid]");
.man.registerArg (".qf.cross_book_at_sizes";"throws";"";"error if sym1 and sym2 share no common currency, or sides has anything other than `bid`ask`mid");
.man.registerArg (".qf.cross_book_at_sizes";"return";"";"a table, one row per size, columns `size`sym plus whichever of bid/bid_filled_size/bid_fully_filled, ask/ask_filled_size/ask_fully_filled, mid were requested via sides");
.man.registerFunc (".qf.cross_rate";".qf";"Triangulate a cross rate: A/B * B/C = A/C.";".qf.cross_rate";".qf.cross_rate[1.10;150]  -> 165f (EURUSD * USDJPY -> EURJPY)");
.man.registerArg (".qf.cross_rate";"param";"ab_rate";"rate for A/B");
.man.registerArg (".qf.cross_rate";"param";"bc_rate";"rate for B/C");
.man.registerArg (".qf.cross_rate";"eg";"";".qf.cross_rate[1.10;150]  -> 165f (EURUSD * USDJPY -> EURJPY)");
.man.registerArg (".qf.cross_rate";"return";"";"the implied rate for A/C");
.man.registerFunc (".qf.cross_rate_shared_base";".qf";"Cross rate via a shared base currency: given two pairs both quoted A/X and A/Y (e.g. EURPLN and EURUSD both quoted against EUR), returns the Y/X cross rate - the common eFX pattern of computing e.g. USDPLN from EURPLN and EURUSD as EURPLN * (1/EURUSD). Simply cross_rate composed with invert_rate; kept as its own named function because \"invert the second one, not the first\" is exactly the kind of thing that's easy to get backwards at the desk.";".qf.cross_rate_shared_base";".qf.cross_rate_shared_base[4.30;1.075]  -> 4f (EURPLN, EURUSD -> USDPLN)");
.man.registerArg (".qf.cross_rate_shared_base";"param";"rate_ax";"rate for A/X (the shared base A over the first quote currency X)");
.man.registerArg (".qf.cross_rate_shared_base";"param";"rate_ay";"rate for A/Y (the shared base A over the second quote currency Y)");
.man.registerArg (".qf.cross_rate_shared_base";"eg";"";".qf.cross_rate_shared_base[4.30;1.075]  -> 4f (EURPLN, EURUSD -> USDPLN)");
.man.registerArg (".qf.cross_rate_shared_base";"return";"";"the implied rate for Y/X");
.man.registerFunc (".qf.cross_sweep_side";".qf";"Private: sweep one side of a 2-leg cross at one size, converting the notional hop-by-hop - leg 2 is swept at the amount of the shared/bridge currency that leg 1's sweep actually produced, not at the raw input size.";".qf.cross_sweep_side";"");
.man.registerArg (".qf.cross_sweep_side";"param";"book2";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 2");
.man.registerArg (".qf.cross_sweep_side";"param";"book1";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for leg 1");
.man.registerArg (".qf.cross_sweep_side";"param";"side";"`bid or `ask - the side of the final cross being priced");
.man.registerArg (".qf.cross_sweep_side";"param";"size";"the size to sweep, in leg 1's relevant currency");
.man.registerArg (".qf.cross_sweep_side";"param";"invert1";"1b if leg 1 needs its convention flipped");
.man.registerArg (".qf.cross_sweep_side";"param";"invert2";"1b if leg 2 needs its convention flipped");
.man.registerArg (".qf.cross_sweep_side";"return";"";"dict `price`filled_size`fully_filled for this side of the cross");
.man.registerFunc (".qf.fwd_cont";".qf";"Outright forward rate under continuous-compounding CIRP: F = S*exp((rd-rf)*t)";".qf.fwd_cont";".qf.fwd_cont[1.10;0.05;0.02;1]  -> 1.1335");
.man.registerArg (".qf.fwd_cont";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.fwd_cont";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.fwd_cont";"param";"t";"year fraction to the forward date");
.man.registerArg (".qf.fwd_cont";"param";"spot";"spot rate, BASE/QUOTE");
.man.registerArg (".qf.fwd_cont";"eg";"";".qf.fwd_cont[1.10;0.05;0.02;1]  -> 1.1335");
.man.registerArg (".qf.fwd_cont";"return";"";"the outright forward rate");
.man.registerFunc (".qf.fwd_points";".qf";"Forward points = (F-S) scaled into pips.";".qf.fwd_points";".qf.fwd_points[1.132353;1.10;10000]  -> 323.53");
.man.registerArg (".qf.fwd_points";"param";"fwd";"outright forward rate");
.man.registerArg (".qf.fwd_points";"param";"spot";"spot rate");
.man.registerArg (".qf.fwd_points";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
.man.registerArg (".qf.fwd_points";"eg";"";".qf.fwd_points[1.132353;1.10;10000]  -> 323.53");
.man.registerArg (".qf.fwd_points";"return";"";"the forward points, in pips");
.man.registerFunc (".qf.fwd_simple";".qf";"Outright forward rate under simple-interest CIRP: F = S*(1+rd*t)/(1+rf*t)";".qf.fwd_simple";".qf.fwd_simple[1.10;0.05;0.02;1]  -> 1.132353");
.man.registerArg (".qf.fwd_simple";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.fwd_simple";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.fwd_simple";"param";"t";"year fraction to the forward date");
.man.registerArg (".qf.fwd_simple";"param";"spot";"spot rate, BASE/QUOTE");
.man.registerArg (".qf.fwd_simple";"eg";"";".qf.fwd_simple[1.10;0.05;0.02;1]  -> 1.132353");
.man.registerArg (".qf.fwd_simple";"return";"";"the outright forward rate");
.man.registerFunc (".qf.implied_domestic_rate";".qf";"Back out the implied domestic (quote currency) rate from an observed outright, given the foreign (base currency) rate - simple CIRP inverse.";".qf.implied_domestic_rate";".qf.implied_domestic_rate[1.10;1.132353;0.02;1]  -> 0.05");
.man.registerArg (".qf.implied_domestic_rate";"param";"fwd";"observed outright forward rate");
.man.registerArg (".qf.implied_domestic_rate";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qf.implied_domestic_rate";"param";"t";"year fraction to the forward date");
.man.registerArg (".qf.implied_domestic_rate";"param";"spot";"spot rate");
.man.registerArg (".qf.implied_domestic_rate";"eg";"";".qf.implied_domestic_rate[1.10;1.132353;0.02;1]  -> 0.05");
.man.registerArg (".qf.implied_domestic_rate";"return";"";"the implied domestic (quote currency) decimal annual rate");
.man.registerFunc (".qf.implied_foreign_rate";".qf";"Back out the implied foreign (base currency) rate from an observed outright, given the domestic (quote currency) rate - simple CIRP inverse.";".qf.implied_foreign_rate";".qf.implied_foreign_rate[1.10;1.132353;0.05;1]  -> 0.02");
.man.registerArg (".qf.implied_foreign_rate";"param";"fwd";"observed outright forward rate");
.man.registerArg (".qf.implied_foreign_rate";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qf.implied_foreign_rate";"param";"t";"year fraction to the forward date");
.man.registerArg (".qf.implied_foreign_rate";"param";"spot";"spot rate");
.man.registerArg (".qf.implied_foreign_rate";"eg";"";".qf.implied_foreign_rate[1.10;1.132353;0.05;1]  -> 0.02");
.man.registerArg (".qf.implied_foreign_rate";"return";"";"the implied foreign (base currency) decimal annual rate");
.man.registerFunc (".qf.invert_book";".qf";"Invert an order book: BASE/QUOTE -> QUOTE/BASE. Inverting flips which side is more favourable, so the new bid comes from the old ask and vice versa.";".qf.invert_book";".qf.invert_book[`bid`ask!(1.1000;1.1002)]  -> `bid`ask!(0.9089256;0.9090909)");
.man.registerArg (".qf.invert_book";"param";"book";"a dict `bid`ask!(bidPx;askPx) quoted BASE/QUOTE");
.man.registerArg (".qf.invert_book";"eg";"";".qf.invert_book[`bid`ask!(1.1000;1.1002)]  -> `bid`ask!(0.9089256;0.9090909)");
.man.registerArg (".qf.invert_book";"return";"";"the same book quoted QUOTE/BASE");
.man.registerFunc (".qf.invert_book_depth";".qf";"Invert a multi-level depth ladder: BASE/QUOTE -> QUOTE/BASE. Prices invert elementwise (order stays best-first automatically: inverting a monotonic ladder reverses its sense exactly the way flipping ask<->bid requires). Sizes rescale into the new base currency - a level of size BASE units at price QUOTE/BASE is worth size*price QUOTE units, which become the new base currency's size.";".qf.invert_book_depth";".qf.invert_book_depth[1.1000 1.1002;1000000 1000000]  -> (0.9090909 0.9089256;1100000 1100200)");
.man.registerArg (".qf.invert_book_depth";"param";"sizes";"level sizes in the ladder's own base currency, aligned to prices");
.man.registerArg (".qf.invert_book_depth";"param";"prices";"level prices, best-first");
.man.registerArg (".qf.invert_book_depth";"eg";"";".qf.invert_book_depth[1.1000 1.1002;1000000 1000000]  -> (0.9090909 0.9089256;1100000 1100200)");
.man.registerArg (".qf.invert_book_depth";"return";"";"(invertedPrices;rescaledSizes), still best-first");
.man.registerFunc (".qf.invert_rate";".qf";"Invert a quote convention: BASE/QUOTE -> QUOTE/BASE.";".qf.invert_rate";".qf.invert_rate 2f  -> 0.5");
.man.registerArg (".qf.invert_rate";"param";"rate";"a rate quoted BASE/QUOTE");
.man.registerArg (".qf.invert_rate";"eg";"";".qf.invert_rate 2f  -> 0.5");
.man.registerArg (".qf.invert_rate";"return";"";"the same rate quoted QUOTE/BASE");
.man.registerFunc (".qf.oriented_levels";".qf";"Private: the (prices;sizes) to sweep for one leg, for one side of the final cross. If this leg doesn't need inverting, that's just its own same-named side; if it does, it's the *other* original side, inverted (an inverted bid becomes an ask, and vice versa).";".qf.oriented_levels";"");
.man.registerArg (".qf.oriented_levels";"param";"side";"`bid or `ask - the side of the final cross being priced");
.man.registerArg (".qf.oriented_levels";"param";"invert";"1b if this leg's convention needs flipping");
.man.registerArg (".qf.oriented_levels";"param";"book";"dict `bid_prices`bid_sizes`ask_prices`ask_sizes for this leg");
.man.registerArg (".qf.oriented_levels";"return";"";"(prices;sizes) to pass to sweep_price");
.man.registerFunc (".qf.points_to_outright";".qf";"Recover the outright from spot plus forward points.";".qf.points_to_outright";".qf.points_to_outright[1.10;323.53;10000]  -> 1.132353");
.man.registerArg (".qf.points_to_outright";"param";"spot";"spot rate");
.man.registerArg (".qf.points_to_outright";"param";"pip_factor";"10000 for most pairs, 100 for JPY crosses");
.man.registerArg (".qf.points_to_outright";"param";"points";"forward points, in pips");
.man.registerArg (".qf.points_to_outright";"eg";"";".qf.points_to_outright[1.10;323.53;10000]  -> 1.132353");
.man.registerArg (".qf.points_to_outright";"return";"";"the outright forward rate");
.man.registerFunc (".qf.side_cols";".qf";"Private: the result columns contributed by one requested side.";".qf.side_cols";"");
