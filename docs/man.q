.man.registerArg (".qopt.d1";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.d1";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.d1";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.d1";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.d1";"return";"";"the Garman-Kohlhagen d1 term");
.man.registerArg (".qopt.d1";"eg";"";".qopt.d1[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.05174784");
.man.registerFunc (".qopt.d2";".qopt";"The Garman-Kohlhagen d2 term.";".qopt.d2";".qopt.d2[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.0348547");
.man.registerArg (".qopt.d2";"param";"s";"spot rate");
.man.registerArg (".qopt.d2";"param";"k";"strike");
.man.registerArg (".qopt.d2";"param";"rd";"domestic (quote currency) decimal annual rate");
.man.registerArg (".qopt.d2";"param";"rf";"foreign (base currency) decimal annual rate");
.man.registerArg (".qopt.d2";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.d2";"param";"t";"year fraction to expiry");
