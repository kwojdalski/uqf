.man.registerArg (".qopt.gk_rho_call";"param";"sigma";"volatility, decimal (0.10 = 10%)");
.man.registerArg (".qopt.gk_rho_call";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_rho_call";"return";"";"the call's rho");
.man.registerArg (".qopt.gk_rho_call";"eg";"";".qopt.gk_rho_call[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.3947712");
.man.registerFunc (".qopt.gk_rho_put";".qopt";"Put rho: sensitivity to the domestic rate rd.";".qopt.gk_rho_put";".qopt.gk_rho_put[1.10;1.12;0.045;0.02;0.10;0.75]  -> -0.4173519");
