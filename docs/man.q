.man.registerArg (".qopt.gk_call";"param";"t";"year fraction to expiry");
.man.registerArg (".qopt.gk_call";"return";"";"the call premium");
.man.registerArg (".qopt.gk_call";"eg";"";".qopt.gk_call[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.03781082");
.man.registerFunc (".qopt.gk_put";".qopt";"European put premium, in domestic/quote currency per unit of base notional.";".qopt.gk_put";".qopt.gk_put[1.10;1.12;0.045;0.02;0.10;0.75]  -> 0.03701845");
