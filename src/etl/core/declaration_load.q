/ declaration_load.q - which declaration files a process loads (.qetl.load, #902).
/ .
/ A declaration asks the plant for its tables AT LOAD TIME - market_data.q
/ takes `.qetl.plant.columns[`quote;...]` - so a process that loads every
/ declaration fails on the first one whose table its schema lacks, whether or
/ not it runs that job. A sidecar deployed against a managed TorQ schema
/ without `quote` could not start because the demo's market_data needed it.
/ .
/ So a process may set .qetl.load.only BEFORE loading src/etl/init.q, to the
/ procnames or job names it runs, and loads only their closure: their own
/ declarations and every source, transform, peer job and reaction those
/ reach. An empty symbol list is the infrastructure-only selection - no
/ declarations at all. Unset, the whole tree loads, as tests and the docs
/ tooling want.
/ .
/ .qetl.load.only_sources does the same for source names: a source's file and
/ what it reaches, and no job - what `uqs config sources check` loads, so a
/ demo job whose plant table a site lacks cannot stop a check of its source.
/ Set with .qetl.load.only too, a process loads both selections.
/ .
/ The closure is not computed here. Resolving it in q would mean loading the
/ declarations whose failure this avoids, so python/uqs/src/uqs/model/
/ load_plan.py reads them as text and src/etl/generated/load_plan.q writes the
/ result down - .qetl.load.order, .jobs, .procs and .declares, which init.q
/ loads before this file's functions are called.

\d .

/ The declaration files `names` select, in init.q's load order.
/ @param names procnames or job names, as a symbol list; empty selects none
/ @return the files' paths, relative to the repository root
/ @throws error naming every name the plan does not know
/ @eg .qetl.load.files `symbol$()  ->  ()
.qetl.load.files:{[names]
    names:(),names;
    if[count bad:names where not names in key[.qetl.load.procs],key .qetl.load.jobs;
        '"etl load: no declared process or job named ",(", " sv string bad),
            " - src/etl/generated/load_plan.q is regenerated by",
            " scripts/generate/generate_operational_docs.py"];
    want:raze {[n] $[n in key .qetl.load.procs; .qetl.load.procs n; .qetl.load.jobs n]} each names;
    .qetl.load.order where .qetl.load.order in want}

/ The declaration files the sources `names` select: each source's file and
/ what it reaches, in init.q's load order.
/ @param names source names, as a symbol list; empty selects none
/ @return the files' paths, relative to the repository root
/ @throws error naming every source the plan does not know
/ @eg .qetl.load.source_files `symbol$()  ->  ()
.qetl.load.source_files:{[names]
    names:(),names;
    if[count bad:names where not names in key .qetl.load.sources;
        '"etl load: no declared source named ",(", " sv string bad),
            " - src/etl/generated/load_plan.q is regenerated by",
            " scripts/generate/generate_operational_docs.py"];
    want:raze .qetl.load.sources names;
    .qetl.load.order where .qetl.load.order in want}

/ Load one declaration file, or fail naming it and the jobs it declares.
/ q's own error says what went wrong but not where, and a process that loads
/ thirty declarations cannot otherwise say which one stopped it.
/ @param f the file's path, relative to the repository root
/ @return the file's path
/ @throws error naming the file and its jobs, then q's own message
.qetl.load.one:{[f]
    @[system;"l ",f;{[f;e]
        js:$[(`$f) in key .qetl.load.declares; .qetl.load.declares `$f; `symbol$()];
        '"etl load: ",f,$[count js;" (job ",(", " sv string js),")";""]," failed: ",e}[f]];
    f}

/ The files a process selected - jobs and processes through .qetl.load.only,
/ sources through .qetl.load.only_sources, both when both are set - or every
/ declaration when it selected none.
/ @param dirs the declaration directories, in load order, for the full load
/ @return the files' paths, in init.q's load order
.qetl.load.selected:{[dirs]
    sel:`only`only_sources inter key `.qetl.load;
    if[0=count sel; :raze .qetl.load.dir_files each dirs];
    want:$[`only in sel; .qetl.load.files[.qetl.load.only]; ()],$[`only_sources in sel; .qetl.load.source_files[.qetl.load.only_sources]; ()];
    .qetl.load.order where .qetl.load.order in want}

/ Load what a process selected, or every declaration when it selected none.
/ @param dirs the declaration directories, in load order, for the full load
/ @return the files loaded
.qetl.load.declarations:{[dirs] .qetl.load.one each .qetl.load.selected dirs}

/ Every .q file under `dir`, alphabetically - the full load's order.
/ @param dir a directory relative to the repository root
/ @return the files' paths
/ @throws error when a required directory holds none
.qetl.load.dir_files:{[dir]
    found:key hsym `$dir;
    found:asc found where found like "*.q";
    / Reactions may be absent or empty - a tree need have none.
    if[(0=count found) and not dir like "*reactions"; '"etl load: no .q files under ",dir];
    (dir,"/"),/:string found}

\d .
