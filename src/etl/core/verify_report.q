/ verify_report.q - one scoped report per dataset: schema, behaviour, cross-mode
/ equivalence and completeness, each PASS, FAIL or UNVERIFIED (.qetl.verify, #1851).
/ .
/ This is the whole verification, and it runs in q: `uqs job check` starts a q,
/ calls `run` and prints what comes back, so nothing that matters is the CLI's and
/ the same call works from a q prompt or a scheduler. The rules that decide a
/ verdict - which columns are keys, what the destination generates, what is refused -
/ are the files this one assembles.
/ .
/ EVERY RESULT states its dataset, scope, time bounds and the basis it rests on (the
/ source and its cutoff, the equivalence basis, the producers captured). A check that
/ did not run, an empty sample, an unknown boundary or an unsupported comparison is
/ UNVERIFIED with a reason; there is no path to PASS that did not compare something.

\d .

/ The four categories, in the order a report lists them.
.qetl.verify.categories:`schema`behaviour`cross_mode`completeness

/ Private: one category's result as a one-row table.
/ @private
.qetl.verify.result:{[category;status;dataset;scope;bounds;basis;reason;findings]
    ([] category:enlist category; status:enlist status; dataset:enlist dataset; scope:enlist scope;
        range_from:enlist bounds 0; range_to:enlist bounds 1; basis:enlist basis; reason:enlist reason; findings:enlist findings)}

/ Private: a findings table as report lines.
/ @private
.qetl.verify.finding_lines:{[f]
    $[0=count f; (); {[r] string[r`producer]," -> ",string[r`destination],".",string[r`column],": ",string[r`problem],", expected ",r[`expected],", actual ",r`actual} each f]}

/ Private: the schema category from a capture.
/ @private
.qetl.verify.schema_result:{[dataset;cap]
    p:cap`producers;
    dest:.qetl.verify.destination dataset;
    if[(::)~dest; :(`UNVERIFIED;"the plant declares no table ",string[dataset],", so there is no destination schema to compare with";"";())];
    found:.qetl.verify.key_findings[dataset;p];
    compared:`symbol$();
    notes:();
    i:0;
    while[i<count p;
        n:p[`producer] i;
        if[(p[`mode] i) in `stream`bounded;
            r:first (cap`captures) n;
            decl:p[`declared] i;
            if[98h=type decl; found,:.qetl.verify.schema_findings[n;dataset;decl;`declared]; compared,:n];
            if[(98h=type r`rows) and 0<count r`rows; found,:.qetl.verify.schema_findings[n;dataset;r`rows;`sample]; compared,:n];
            if[count r`failures; found,:raze {[n;d;m] .qetl.verify.finding[n;d;`;`contract;"the plant's contract";m;`sample]}[n;dataset] each r`failures]];
        if[(p[`mode] i)=`reaction; notes,:enlist string[n]," is a reaction: its output is not captured, so its schema was not compared"];
        i+:1];
    capturable:(p`producer) where (p`mode) in `stream`bounded;
    left:capturable except compared;
    text:"destination ",string[dataset]," publishes ",(", " sv string cols dest`published),"; generated by the destination: ",", " sv string dest`generated;
    lines:.qetl.verify.finding_lines found;
    $[count found; (`FAIL;"";text;lines);
      count left; (`UNVERIFIED;(", " sv string left)," declare no output and returned no sample - nothing was compared";text;lines);
      count notes; (`UNVERIFIED;"; " sv notes;text;lines);
      (`PASS;"";text;lines)]}

/ Private: the cross-mode category.
/ @private
.qetl.verify.cross_result:{[dataset;cap]
    v:.qetl.verify.cross_mode[dataset;cap];
    lines:{[r] string[r`producer]," ",string[r`kind]," ",r[`rowkey],": ",r`detail} each v`findings;
    (v`status;v`reason;v`basis;$[0=count lines; (); lines])}

/ Private: the completeness category.
/ @private
.qetl.verify.completeness_result:{[dataset;scope;from_ts;to_ts;reader]
    v:.qetl.verify.completeness[dataset;scope;from_ts;to_ts;reader];
    lines:{[r] string[r`kind]," ",r[`rowkey],": ",r`detail} each v`findings;
    (v`status;v`reason;(v`basis),$[(2=count v`counts) and 0<count v`basis; "; source ",string[v[`counts] 0]," record(s), destination ",string v[`counts] 1; ""];$[0=count lines; (); lines])}

/ The behaviours no harness here exercises, as UNVERIFIED rows with the reason and what
/ covers the behaviour generically.
/ @param producers the producers table
/ @return a table behaviour, mode, producer, status, reason, evidence
/ @eg count .qetl.verify.behaviour_gaps .qetl.verify.producers `demo_deals  ->  3
.qetl.verify.behaviour_gaps:{[producers]
    js:(producers`producer) where (producers`mode)=`stream;
    gap:{[j]
        raze .qetl.verify.behaviour_row[;`stream;j;`UNVERIFIED;;]'[`slow_queries`startup_failure`late_arrivals;
            ("no per-fetch deadline exists to exercise: a hung fetch is bounded only by its caller (a preview of a feed gives up after a fixed time)";
             "starting a process is not run in a sandbox; the declaration's on_start is held generically by the stream job suites";
             "no double can inject a row into a source after a cursor has passed it; a timestamp cursor skips such a row - a known gap, recovery is out of scope");
            ("";"";"")]};
    $[0=count js; .qetl.verify.behaviour_row[`none;`none;`none;`UNVERIFIED;"";""]; raze gap each js]}

/ Private: run every implemented behaviour check for the producers.
/ @private
.qetl.verify.behaviour_results:{[cap;from_ts;to_ts]
    p:cap`producers;
    out:.qetl.verify.behaviour_row[`none;`none;`none;`UNVERIFIED;"";""];
    out:0#out;
    i:0;
    while[i<count p;
        n:p[`producer] i; m:p[`mode] i;
        add:{[out;n;m;name;r] out,.qetl.verify.behaviour_row[name;m;n;r`status;r`reason;r`evidence]};
        if[m=`stream;
            out:add[out;n;m;`cursor_progression;.qetl.verify.check_cursor n];
            out:add[out;n;m;`publish_recovery;.qetl.verify.check_publish_recovery n]];
        if[m=`bounded;
            rows:(first (cap`captures) n)`rows;
            out:add[out;n;m;`window_boundaries;.qetl.verify.check_windows[n;from_ts;to_ts;rows]];
            out:add[out;n;m;`retries;.qetl.verify.check_retries[n;from_ts;from_ts+(.qetl.job.bounded.def n)`width]];
            out:add[out;n;m;`conflict_handling;.qetl.verify.check_conflict[n;rows;from_ts;to_ts]];
            out:add[out;n;m;`coverage_recording;.qetl.verify.check_coverage[n;from_ts;to_ts;$[98h=type rows; count rows; 0]]]];
        i+:1];
    out}

/ Verify a dataset over one closed window: capture, then the four categories.
/ @param dataset the dataset
/ @param scope column -> value dict for the completeness check (empty leaves it UNVERIFIED)
/ @param from_ts the window's first instant
/ @param to_ts the instant after its last
/ @param reader the destination reader for completeness, or (::)
/ @param behaviours 1b to exercise behaviours in a sandbox (refused outside a throwaway q), 0b to leave them unrun
/ @return a dict of dataset, range_from, range_to, producers (the job graph's), readonly
/   (the snapshot held equal across capture), checks (one row per category) and behaviours
/ @throws error when behaviours are asked for in a process that is not a throwaway q
/ @eg exec status from .qetl.verify.run[`demo_deals;enlist[`sym]!enlist `EURUSD;2026.09.11D00:00:00.000000000;2026.09.14D00:00:00.000000000;{[d;f;t] .qpipe.source.demo_deals.fixture[]};0b]`checks where category in `schema`cross_mode`completeness  ->  `PASS`PASS`PASS
.qetl.verify.run:{[dataset;scope;from_ts;to_ts;reader;behaviours]
    if[behaviours; .qetl.verify.require_isolated[]];
    cap:.qetl.verify.capture[dataset;from_ts;to_ts];
    sc:.qetl.verify.schema_result[dataset;cap];
    cr:.qetl.verify.cross_result[dataset;cap];
    co:.qetl.verify.completeness_result[dataset;scope;from_ts;to_ts;reader];
    gaps:.qetl.verify.behaviour_gaps cap`producers;
    gaps:select from gaps where mode<>`none;
    ran:$[behaviours; .qetl.verify.behaviour_results[cap;from_ts;to_ts]; 0#gaps];
    bh:ran,gaps;
    unrun:$[behaviours; ""; "behaviours were not run (--no-behaviours)"];
    bstatus:$[any bh[`status]=`FAIL; `FAIL; (not behaviours) or any bh[`status]=`UNVERIFIED; `UNVERIFIED; `PASS];
    breason:$[bstatus=`UNVERIFIED; $[count unrun; unrun; string[count select from bh where status=`UNVERIFIED]," of ",string[count bh]," behaviour check(s) are unverified: ",", " sv string distinct exec behaviour from bh where status=`UNVERIFIED]; ""];
    blines:{[r] string[r`status]," ",string[r`behaviour]," (",string[r`producer],")",$[count r`reason; ": ",r`reason; ""]} each bh;
    sb:"sandboxed: a throwaway status directory, publish on a recorder, faults on fixtures only";
    checks:raze (
        .qetl.verify.result[`schema;sc 0;dataset;"";(from_ts;to_ts);sc 2;sc 1;sc 3];
        .qetl.verify.result[`behaviour;bstatus;dataset;"";(from_ts;to_ts);sb;breason;blines];
        .qetl.verify.result[`cross_mode;cr 0;dataset;"";(from_ts;to_ts);cr 2;cr 1;cr 3];
        .qetl.verify.result[`completeness;co 0;dataset;$[count scope; ", " sv {string[x],"=",$[10h=abs type y; (),y; .qf.util.full y]}'[key scope;value scope]; ""];(from_ts;to_ts);co 2;co 1;co 3]);
    `dataset`range_from`range_to`producers`readonly`checks`behaviours!(dataset;from_ts;to_ts;select producer,mode,source from cap`producers;cap`readonly;checks;bh)}

\d .
